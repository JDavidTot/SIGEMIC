@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-danger">
                <div class="card-body text-center p-5">
                    <div class="display-4 text-danger mb-3">403</div>

                    <h2 class="mb-3">
                        Acceso denegado
                    </h2>

                    <p class="text-muted mb-4">
                        Tu usuario no tiene permiso para realizar esta operación.
                        Si necesitas acceso, comunícate con un administrador de SIGEMIC.
                    </p>

                    @if (User.IsInRole("CAJERO"))
                    {
                        <a asp-controller="Cajero"
                           asp-action="Index"
                           class="btn btn-primary">
                            Volver al Dashboard
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-primary">
                            Volver al inicio
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
                    </ul>


                    <!-- =================================================
                         CUENTA DEL USUARIO
                         ================================================= -->

                    @if (
                        User.Identity?.IsAuthenticated ==
                        true
                    )
                    {

                        <ul class="navbar-nav
                                   sigemic-user-area">

                            <li class="nav-item
                                       dropdown">

                                <button class="user-dropdown-button
                                               dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    Usuario:

                                    <span class="user-name">

                                        @User.Identity.Name

                                    </span>

                                </button>


                                <ul class="dropdown-menu
                                           dropdown-menu-end">


                                    <!-- =================================
                                         PERFIL ADMIN
                                         ================================= -->

                                    @if (
                                        User.IsInRole(
                                            "ADMINISTRADOR"
                                        )
                                    )
                                    {
                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Perfil"
                                               asp-action="Administrador">

                                                Mi perfil

                                            </a>

                                        </li>


                                        <li>

                                            <hr class="dropdown-divider" />

                                        </li>
                                    }


                                    <!-- =================================
                                         CUENTA CLIENTE
                                         ================================= -->

                                    @if (
                                        User.IsInRole(
                                            "CLIENTE"
                                        )
                                    )
                                    {
                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Cliente"
                                               asp-action="Index">

                                                Mi cuenta

                                            </a>

                                        </li>


                                        <li>

                                            <hr class="dropdown-divider" />

                                        </li>
                                    }


                                    <!-- =================================
                                         CERRAR SESIÓN
                                         ================================= -->

                                    <li>

                                        <form asp-controller="Account"
                                              asp-action="Logout"
                                              method="post"
                                              class="m-0">

                                            @Html.AntiForgeryToken()


                                            <button type="submit"
                                                    class="logout-dropdown-button">

                                                Cerrar sesión

                                            </button>

                                        </form>

                                    </li>

                                </ul>

                            </li>

                        </ul>

                    }


<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - SIGEMIC
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SIGEMIC.styles.css"
          asp-append-version="true" />

</head>


<body class="bg-light">

    <!-- =====================================================
         BARRA SUPERIOR
         ===================================================== -->

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">

            <div class="container">

                <!-- LOGO / NOMBRE -->
                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">

                    SIGEMIC

                </a>


                <!-- BOTÓN MÓVIL -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal"
                        aria-expanded="false"
                        aria-label="Menú">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="collapse navbar-collapse"
                     id="menuPrincipal">

                    <!-- =================================================
                         MENÚ IZQUIERDO
                         ================================================= -->

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <!-- INICIO -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Inicio

                            </a>

                        </li>


                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- =========================================
                                 ADMINISTRADOR
                                 ========================================= -->

                            @if (User.IsInRole("ADMINISTRADOR"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Admin"
                                       asp-action="Index">

                                        Dashboard

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Clientes"
                                       asp-action="Index">

                                        Clientes

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Creditos"
                                       asp-action="Index">

                                        Créditos

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="PlanesCredito"
                                       asp-action="Index">

                                        Planes

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Pagos"
                                       asp-action="Index">

                                        Pagos

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Pagos"
                                       asp-action="Historial">

                                        Historial

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link disabled"
                                       href="#">

                                        Auditoría

                                    </a>

                                </li>
                            }


                            else if (User.IsInRole("CAJERO"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Cajero"
                                       asp-action="Index">

                                        Dashboard

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Clientes"
                                       asp-action="Index">

                                        Clientes

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Creditos"
                                       asp-action="Index">

                                        Créditos

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Pagos"
                                       asp-action="Index">

                                        Registrar pago

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Pagos"
                                       asp-action="Historial">

                                        Historial

                                    </a>

                                </li>
                            }


                            else if (User.IsInRole("CLIENTE"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Cliente"
                                       asp-action="Index">

                                        Mi cuenta

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Cliente"
                                       asp-action="Credito">

                                        Mi crédito

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Cliente"
                                       asp-action="Cuotas">

                                        Mis cuotas

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Cliente"
                                       asp-action="EstadoCuenta">

                                        Mis pagos

                                    </a>

                                </li>
                            }
                        }

                    </ul>


                    <!-- =================================================
                         USUARIO / CERRAR SESIÓN
                         ================================================= -->

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="d-flex align-items-center gap-3">

                            <span class="navbar-text text-white">

                                Usuario:
                                <strong>
                                    @User.Identity.Name
                                </strong>

                            </span>


                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="m-0">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-outline-light btn-sm">

                                    Cerrar sesión

                                </button>

                            </form>

                        </div>
                    }

                </div>

            </div>

        </nav>

    </header>


    <!-- =====================================================
         CONTENIDO
         ===================================================== -->

    <main role="main"
          class="pb-5">

        @RenderBody()

    </main>


    <!-- =====================================================
         PIE DE PÁGINA
         ===================================================== -->

    <footer class="border-top bg-white text-muted py-3 mt-auto">

        <div class="container text-center">

            © 2026 - SIGEMIC

            <span class="mx-1">
                |
            </span>

            Sistema de Gestión de Microcréditos

        </div>

    </footer>


    <!-- =====================================================
         SCRIPTS
         ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>
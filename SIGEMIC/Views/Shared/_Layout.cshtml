            </div>

        </nav>

    </header>


    <!-- =====================================================
         CONTENIDO PRINCIPAL
         ===================================================== -->

    <main role="main"
          class="pb-5">

        @RenderBody()

    </main>


    <!-- =====================================================
         PIE DE PÁGINA
         ===================================================== -->

    <footer class="border-top
                   bg-white
                   text-muted
                   py-3
                   mt-auto">

        <div class="container
                    text-center">

            © 2026 - SIGEMIC

            <span class="mx-1">
                |
            </span>

            Sistema de Gestión de Microcréditos

        </div>

    </footer>


    <!-- =====================================================
         SCRIPTS
         ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>
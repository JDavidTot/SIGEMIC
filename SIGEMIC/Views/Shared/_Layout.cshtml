@using System.Security.Claims
@inject SIGEMIC.Services.PermisoService PermisoService

@{
    var permisosCajero =
        new HashSet<string>(
            StringComparer.OrdinalIgnoreCase
        );

    bool puedeVerClientes = false;
    bool puedeVerCreditos = false;
    bool puedeRegistrarPago = false;
    bool puedeVerSolicitudes = false;
    bool puedeVerHistorial = false;

    if (
        User.Identity?.IsAuthenticated == true &&
        User.IsInRole("CAJERO")
    )
    {
        var idTexto =
            User.FindFirstValue(
                ClaimTypes.NameIdentifier
            );

        if (
            uint.TryParse(
                idTexto,
                out uint idUsuario
            )
        )
        {
            var permisos =
                await PermisoService
                    .ObtenerPermisosAsync(
                        idUsuario
                    );

            foreach (var permiso in permisos)
            {
                permisosCajero.Add(
                    permiso
                );
            }
        }

        puedeVerClientes =
            permisosCajero.Contains(
                "CLIENTES_VER"
            );

        puedeVerCreditos =
            permisosCajero.Contains(
                "CREDITOS_VER"
            );

        puedeRegistrarPago =
            permisosCajero.Contains(
                "PAGOS_REGISTRAR"
            );

        puedeVerSolicitudes =
            permisosCajero.Contains(
                "SOLICITUDES_VER"
            );

        puedeVerHistorial =
            permisosCajero.Contains(
                "PAGOS_HISTORIAL"
            );
    }

    bool mostrarOperacionesCajero =
        puedeVerClientes ||
        puedeVerCreditos;

    bool mostrarPagosCajero =
        puedeRegistrarPago ||
        puedeVerSolicitudes ||
        puedeVerHistorial;
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - SIGEMIC
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SIGEMIC.styles.css"
          asp-append-version="true" />


    <style>

        /* =====================================================
           BARRA PRINCIPAL
           ===================================================== */

        .sigemic-navbar {
            min-height: 54px;
        }

        .sigemic-navbar .navbar-brand {
            letter-spacing: .02rem;
        }

        .sigemic-navbar .nav-link {
            border-radius: 6px;
            padding-left: .75rem;
            padding-right: .75rem;
            transition:
                background-color .15s ease,
                color .15s ease;
        }

        .sigemic-navbar .nav-link:hover,
        .sigemic-navbar .nav-link:focus {
            background:
                rgba(255, 255, 255, .12);
            color: #ffffff;
        }


        /* =====================================================
           MENÚS DESPLEGABLES
           ===================================================== */

        .sigemic-navbar .dropdown-menu {
            min-width: 220px;

            padding: .45rem;

            border: 1px solid #e5e7eb;

            border-radius: 10px;

            box-shadow:
                0 10px 30px
                rgba(0, 0, 0, .10);
        }

        .sigemic-navbar .dropdown-item {
            border-radius: 7px;

            padding:
                .55rem .75rem;

            font-size: .92rem;
        }

        .sigemic-navbar .dropdown-item:hover,
        .sigemic-navbar .dropdown-item:focus {
            background: #f0f5ff;
            color: #0d6efd;
        }

        .dropdown-section-title {
            padding:
                .35rem .75rem
                .25rem;

            font-size: .72rem;

            font-weight: 700;

            text-transform: uppercase;

            letter-spacing: .05rem;

            color: #8a929f;
        }


        /* =====================================================
           MENÚ DEL USUARIO
           ===================================================== */

        .user-dropdown-button {
            border: none;

            background: transparent;

            color: white;

            font-size: .9rem;

            padding:
                .4rem .65rem;

            border-radius: 6px;
        }

        .user-dropdown-button:hover,
        .user-dropdown-button:focus {
            background:
                rgba(255,255,255,.12);

            color: white;
        }

        .user-name {
            font-weight: 700;
        }

        .logout-dropdown-button {
            width: 100%;

            border: 0;

            background: transparent;

            text-align: left;

            padding:
                .55rem .75rem;

            border-radius: 7px;

            font-size: .92rem;

            color: #dc3545;
        }

        .logout-dropdown-button:hover {
            background: #fff1f2;
        }


        /* =====================================================
           ABRIR TAMBIÉN AL PASAR EL MOUSE
           SOLO EN COMPUTADORA
           ===================================================== */

        @@media (min-width: 992px) {

            .sigemic-navbar
            .navbar-nav
            .dropdown:hover
            > .dropdown-menu {
                display: block;
                margin-top: 0;
            }

            .sigemic-navbar
            .navbar-nav
            .dropdown:hover
            > .nav-link {
                background:
                    rgba(255, 255, 255, .12);
            }
        }


        /* =====================================================
           MÓVIL
           ===================================================== */

        @@media (max-width: 991.98px) {

            .sigemic-navbar
            .navbar-collapse {
                padding-top: .8rem;
                padding-bottom: .8rem;
            }

            .sigemic-navbar
            .dropdown-menu {
                border: none;

                box-shadow: none;

                background:
                    rgba(255,255,255,.08);

                margin:
                    .25rem 0
                    .5rem;
            }

            .sigemic-navbar
            .dropdown-item {
                color: white;
            }

            .sigemic-navbar
            .dropdown-item:hover {
                background:
                    rgba(255,255,255,.12);

                color: white;
            }

            .dropdown-section-title {
                color:
                    rgba(255,255,255,.65);
            }

            .sigemic-user-area {
                margin-top: .5rem;

                padding-top: .5rem;

                border-top:
                    1px solid
                    rgba(255,255,255,.20);
            }
        }

    </style>

</head>


<body class="bg-light">


    <!-- =====================================================
         BARRA DE NAVEGACIÓN
         ===================================================== -->

    <header>

        <nav class="navbar
                    navbar-expand-lg
                    navbar-dark
                    bg-primary
                    shadow-sm
                    sigemic-navbar">

            <div class="container">


                <!-- =================================================
                     LOGO
                     ================================================= -->

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">

                    SIGEMIC

                </a>


                <!-- =================================================
                     BOTÓN RESPONSIVE
                     ================================================= -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal"
                        aria-expanded="false"
                        aria-label="Mostrar menú">

                    <span class="navbar-toggler-icon">
                    </span>

                </button>


                <div class="collapse
                            navbar-collapse"
                     id="menuPrincipal">


                    <!-- =================================================
                         MENÚ SEGÚN ROL
                         ================================================= -->

                    <ul class="navbar-nav
                               me-auto
                               mb-2
                               mb-lg-0">


                        @if (
                            User.Identity?.IsAuthenticated ==
                            true
                        )
                        {

                            <!-- =========================================
                                 ADMINISTRADOR
                                 ========================================= -->

                            @if (
                                User.IsInRole(
                                    "ADMINISTRADOR"
                                )
                            )
                            {

                                <!-- DASHBOARD -->

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Admin"
                                       asp-action="Index">

                                        Dashboard

                                    </a>

                                </li>


                                <!-- =====================================
                                     OPERACIONES
                                     ===================================== -->

                                <li class="nav-item dropdown">

                                    <a class="nav-link
                                              dropdown-toggle"
                                       href="#"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">

                                        Operaciones

                                    </a>


                                    <ul class="dropdown-menu">


                                        <li>

                                            <div class="dropdown-section-title">

                                                Gestión

                                            </div>

                                        </li>


                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Clientes"
                                               asp-action="Index">

                                                Clientes

                                            </a>

                                        </li>


                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Creditos"
                                               asp-action="Index">

                                                Créditos

                                            </a>

                                        </li>


                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="PlanesCredito"
                                               asp-action="Index">

                                                Planes de crédito

                                            </a>

                                        </li>

                                    </ul>

                                </li>


                                <!-- =====================================
                                     PAGOS
                                     ===================================== -->

                                <li class="nav-item dropdown">

                                    <a class="nav-link
                                              dropdown-toggle"
                                       href="#"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">

                                        Pagos

                                    </a>


                                    <ul class="dropdown-menu">


                                        <li>

                                            <div class="dropdown-section-title">

                                                Movimientos

                                            </div>

                                        </li>


                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Pagos"
                                               asp-action="Index">

                                                Registrar pago

                                            </a>

                                        </li>


                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="SolicitudesPago"
                                               asp-action="Index">

                                                Solicitudes de pago

                                            </a>

                                        </li>


                                        <li>

                                            <hr class="dropdown-divider" />

                                        </li>


                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Pagos"
                                               asp-action="Historial">

                                                Historial de pagos

                                            </a>

                                        </li>

                                    </ul>

                                </li>


                                <!-- =====================================
                                     ADMINISTRACIÓN
                                     ===================================== -->

                                <li class="nav-item dropdown">

                                    <a class="nav-link
                                              dropdown-toggle"
                                       href="#"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">

                                        Administración

                                    </a>


                                    <ul class="dropdown-menu">


                                        <li>

                                            <div class="dropdown-section-title">

                                                Sistema

                                            </div>

                                        </li>


                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Usuarios"
                                               asp-action="Index">

                                                Usuarios

                                            </a>

                                        </li>


                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Auditoria"
                                               asp-action="Index">

                                                Auditoría

                                            </a>

                                        </li>

                                    </ul>

                                </li>

                            }



                            else if (
                                User.IsInRole(
                                    "CAJERO"
                                )
                            )
                            {

                                <!-- DASHBOARD -->

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Cajero"
                                       asp-action="Index">

                                        Dashboard

                                    </a>

                                </li>


                                <!-- =====================================
                                     OPERACIONES
                                     ===================================== -->

                                @if (
                                    mostrarOperacionesCajero
                                )
                                {
                                    <li class="nav-item dropdown">

                                        <a class="nav-link
                                                  dropdown-toggle"
                                           href="#"
                                           role="button"
                                           data-bs-toggle="dropdown"
                                           aria-expanded="false">

                                            Operaciones

                                        </a>


                                        <ul class="dropdown-menu">


                                            <li>

                                                <div class="dropdown-section-title">

                                                    Gestión

                                                </div>

                                            </li>


                                            @if (
                                                puedeVerClientes
                                            )
                                            {
                                                <li>

                                                    <a class="dropdown-item"
                                                       asp-controller="Clientes"
                                                       asp-action="Index">

                                                        Clientes

                                                    </a>

                                                </li>
                                            }


                                            @if (
                                                puedeVerCreditos
                                            )
                                            {
                                                <li>

                                                    <a class="dropdown-item"
                                                       asp-controller="Creditos"
                                                       asp-action="Index">

                                                        Créditos

                                                    </a>

                                                </li>
                                            }

                                        </ul>

                                    </li>
                                }


                                <!-- =====================================
                                     PAGOS
                                     ===================================== -->

                                @if (
                                    mostrarPagosCajero
                                )
                                {
                                    <li class="nav-item dropdown">

                                        <a class="nav-link
                                                  dropdown-toggle"
                                           href="#"
                                           role="button"
                                           data-bs-toggle="dropdown"
                                           aria-expanded="false">

                                            Pagos

                                        </a>


                                        <ul class="dropdown-menu">


                                            <li>

                                                <div class="dropdown-section-title">

                                                    Operaciones

                                                </div>

                                            </li>


                                            @if (
                                                puedeRegistrarPago
                                            )
                                            {
                                                <li>

                                                    <a class="dropdown-item"
                                                       asp-controller="Pagos"
                                                       asp-action="Index">

                                                        Registrar pago

                                                    </a>

                                                </li>
                                            }


                                            @if (
                                                puedeVerSolicitudes
                                            )
                                            {
                                                <li>

                                                    <a class="dropdown-item"
                                                       asp-controller="SolicitudesPago"
                                                       asp-action="Index">

                                                        Solicitudes de pago

                                                    </a>

                                                </li>
                                            }


                                            @if (
                                                puedeVerHistorial
                                            )
                                            {
                                                <li>

                                                    <hr class="dropdown-divider" />

                                                </li>


                                                <li>

                                                    <a class="dropdown-item"
                                                       asp-controller="Pagos"
                                                       asp-action="Historial">

                                                        Historial de pagos

                                                    </a>

                                                </li>
                                            }

                                        </ul>

                                    </li>
                                }

                            }


                            else if (
                                User.IsInRole(
                                    "CLIENTE"
                                )
                            )
                            {

                                <!-- MI CUENTA -->

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Cliente"
                                       asp-action="Index">

                                        Mi cuenta

                                    </a>

                                </li>


                                <!-- =====================================
                                     MI CRÉDITO
                                     ===================================== -->

                                <li class="nav-item dropdown">

                                    <a class="nav-link
                                              dropdown-toggle"
                                       href="#"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">

                                        Mi crédito

                                    </a>


                                    <ul class="dropdown-menu">


                                        <li>

                                            <div class="dropdown-section-title">

                                                Crédito

                                            </div>

                                        </li>


                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Cliente"
                                               asp-action="Credito">

                                                Información de mi crédito

                                            </a>

                                        </li>


                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Cliente"
                                               asp-action="Cuotas">

                                                Mis cuotas

                                            </a>

                                        </li>

                                    </ul>

                                </li>


                                <!-- =====================================
                                     PAGOS Y SOLICITUDES
                                     ===================================== -->

                                <li class="nav-item dropdown">

                                    <a class="nav-link
                                              dropdown-toggle"
                                       href="#"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">

                                        Pagos y solicitudes

                                    </a>


                                    <ul class="dropdown-menu">


                                        <li>

                                            <div class="dropdown-section-title">

                                                Seguimiento

                                            </div>

                                        </li>


                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Cliente"
                                               asp-action="EstadoCuenta">

                                                Mis pagos

                                            </a>

                                        </li>


                                        <li>

                                            <hr class="dropdown-divider" />

                                        </li>


                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Cliente"
                                               asp-action="SolicitarPago">

                                                Solicitar pago

                                            </a>

                                        </li>


                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Cliente"
                                               asp-action="MisSolicitudes">


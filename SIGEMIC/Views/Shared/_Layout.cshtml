<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SIGEMIC</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SIGEMIC.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    SIGEMIC
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Mostrar navegación">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- MENÚ IZQUIERDO -->
                   <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                            asp-controller="Home"
                            asp-action="Index">
                                Inicio
                            </a>
                        </li>

                        @if (User.IsInRole("ADMINISTRADOR"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                asp-controller="Admin"
                                asp-action="Index">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                asp-controller="Clientes"
                                asp-action="Index">
                                    Clientes
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("CAJERO"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                asp-controller="Cajero"
                                asp-action="Index">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                asp-controller="Clientes"
                                asp-action="Index">
                                    Clientes
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("CLIENTE"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                asp-controller="Cliente"
                                asp-action="Index">
                                    Mi cuenta
                                </a>
                            </li>
                        }

                    </ul>

                    <!-- MENÚ DERECHO -->
                    <ul class="navbar-nav">

                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">

                                <span class="nav-link text-dark">

                                    Usuario:
                                    <strong>
                                        @User.Identity.Name
                                    </strong>

                                </span>

                            </li>

                            <li class="nav-item">

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    <button type="submit"
                                            class="btn btn-link nav-link text-dark">

                                        Cerrar sesión

                                    </button>

                                </form>

                            </li>
                        }
                        else
                        {
                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    Iniciar sesión

                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <!-- CONTENIDO PRINCIPAL -->

    <div class="container">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>

    <!-- PIE DE PÁGINA -->

    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - SIGEMIC - Sistema de Gestión de Microcréditos - Base de Datos

        </div>

    </footer>

    <!-- SCRIPTS -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts",required: false)

</body>
</html>
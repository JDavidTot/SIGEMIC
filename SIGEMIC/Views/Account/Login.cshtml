@model SIGEMIC.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<style>
    .login-page {
        min-height: calc(100vh - 125px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 35px 15px;
        background:
            radial-gradient(
                circle at 10% 20%,
                rgba(13, 110, 253, .06),
                transparent 28%
            ),
            radial-gradient(
                circle at 90% 80%,
                rgba(89, 54, 180, .06),
                transparent 30%
            ),
            #f6f8fb;
    }

    .login-container {
        width: 100%;
        max-width: 980px;
        min-height: 540px;

        display: grid;
        grid-template-columns: 1.05fr .95fr;

        background: #ffffff;

        border-radius: 24px;

        overflow: hidden;

        box-shadow:
            0 20px 55px
            rgba(29, 43, 76, .14);
    }


    /* ============================================
       PANEL IZQUIERDO
       ============================================ */

    .login-brand {
        position: relative;

        overflow: hidden;

        padding: 55px;

        display: flex;
        flex-direction: column;
        justify-content: center;

        color: white;

        background:
            linear-gradient(
                145deg,
                #0d6efd 0%,
                #3154c9 55%,
                #5638ad 100%
            );
    }

    .login-brand::before {
        content: "";

        position: absolute;

        width: 340px;
        height: 340px;

        border:
            1px solid
            rgba(255, 255, 255, .17);

        border-radius:
            46% 54% 65% 35%;

        top: -170px;
        left: -120px;

        transform:
            rotate(25deg);
    }

    .login-brand::after {
        content: "";

        position: absolute;

        width: 320px;
        height: 320px;

        border:
            1px solid
            rgba(255, 255, 255, .16);

        border-radius:
            57% 43% 36% 64%;

        bottom: -170px;
        right: -120px;

        transform:
            rotate(-25deg);
    }

    .login-decoration {
        position: absolute;

        border:
            2px solid
            rgba(255, 255, 255, .35);

        border-radius: 50%;
    }

    .decoration-1 {
        width: 14px;
        height: 14px;

        top: 72px;
        right: 80px;
    }

    .decoration-2 {
        width: 8px;
        height: 8px;

        bottom: 100px;
        left: 70px;
    }

    .decoration-plus {
        position: absolute;

        font-size: 30px;
        font-weight: 200;

        color:
            rgba(255, 255, 255, .65);

        top: 75px;
        left: 75px;
    }

    .brand-content {
        position: relative;
        z-index: 2;

        max-width: 390px;
    }

    .brand-badge {
        display: inline-block;

        background:
            rgba(255, 255, 255, .15);

        border:
            1px solid
            rgba(255, 255, 255, .22);

        padding:
            7px 13px;

        border-radius: 30px;

        font-size: .78rem;
        font-weight: 600;

        margin-bottom: 25px;

        backdrop-filter:
            blur(5px);
    }

    .brand-title {
        font-size: 2.55rem;
        font-weight: 750;
        line-height: 1.1;

        margin-bottom: 18px;
    }

    .brand-text {
        max-width: 390px;

        font-size: 1rem;
        line-height: 1.7;

        color:
            rgba(255, 255, 255, .88);

        margin-bottom: 0;
    }


    /* ============================================
       PANEL DERECHO
       ============================================ */

    .login-form-panel {
        padding:
            55px 52px;

        display: flex;
        flex-direction: column;
        justify-content: center;

        background: white;
    }

    .sigemic-small {
        font-weight: 800;

        letter-spacing: .08rem;

        color: #0d6efd;

        font-size: .88rem;

        margin-bottom: 15px;
    }

    .login-heading {
        font-size: 2rem;
        font-weight: 750;

        color: #212529;

        margin-bottom: 7px;
    }

    .login-subtitle {
        color: #6c757d;

        font-size: .92rem;

        margin-bottom: 31px;
    }

    .login-form-label {
        font-size: .86rem;
        font-weight: 600;

        color: #343a40;

        margin-bottom: 7px;
    }

    .login-input-group {
        position: relative;
    }

    .login-input {
        height: 48px;

        border:
            1px solid
            #dce1e8;

        border-radius: 10px;

        padding-left: 43px;
        padding-right: 42px;

        font-size: .92rem;

        background: #fbfcfe;

        transition:
            border-color .15s ease,
            box-shadow .15s ease,
            background .15s ease;
    }

    .login-input:focus {
        background: white;

        border-color:
            #0d6efd;

        box-shadow:
            0 0 0 .2rem
            rgba(13, 110, 253, .10);
    }

    .input-icon {
        position: absolute;

        left: 14px;
        top: 50%;

        transform:
            translateY(-50%);

        width: 18px;
        height: 18px;

        color: #8993a4;

        z-index: 4;
    }

    .password-toggle {
        position: absolute;

        right: 10px;
        top: 50%;

        transform:
            translateY(-50%);

        border: none;

        background:
            transparent;

        color: #7e8795;

        padding: 6px;

        border-radius: 6px;

        z-index: 5;
    }

    .password-toggle:hover {
        background:
            #f0f2f5;

        color:
            #0d6efd;
    }

    .forgot-password {
        font-size: .82rem;
        font-weight: 500;

        color: #0d6efd;

        text-decoration: none;
    }

    .forgot-password:hover {
        text-decoration: underline;
    }

    .login-button {
        height: 48px;

        border: none;

        border-radius: 10px;

        font-weight: 600;

        margin-top: 3px;

        background:
            linear-gradient(
                90deg,
                #0d6efd,
                #3d52c9
            );

        box-shadow:
            0 8px 20px
            rgba(13, 110, 253, .20);

        transition:
            transform .15s ease,
            box-shadow .15s ease;
    }

    .login-button:hover {
        transform:
            translateY(-1px);

        box-shadow:
            0 10px 25px
            rgba(13, 110, 253, .27);
    }

    .security-note {
        margin-top: 24px;

        text-align: center;

        font-size: .78rem;

        color: #8a929f;
    }


    /* ============================================
       VALIDACIONES
       ============================================ */

    .validation-summary-valid {
        display: none;
    }

    .validation-summary-errors {
        background: #fff2f2;

        border:
            1px solid
            #f5c2c7;

        color: #842029;

        padding:
            10px 14px;

        border-radius: 9px;

        font-size: .84rem;

        margin-bottom: 18px;
    }

    .validation-summary-errors ul {
        margin: 0;

        padding-left: 18px;
    }

    .field-validation-error {
        display: block;

        font-size: .78rem;

        margin-top: 5px;

        color: #dc3545;
    }


    /* ============================================
       RESPONSIVE
       ============================================ */

    @@media (max-width: 850px) {

        .login-container {
            grid-template-columns:
                1fr;

            max-width: 560px;
        }

        .login-brand {
            padding: 40px;

            min-height: 300px;
        }

        .brand-title {
            font-size: 2rem;
        }

        .login-form-panel {
            padding:
                42px 36px;
        }
    }


    @@media (max-width: 480px) {

        .login-page {
            padding:
                20px 12px;
        }

        .login-container {
            border-radius: 16px;
        }

        .login-brand {
            padding:
                32px 25px;

            min-height: 250px;
        }

        .brand-title {
            font-size: 1.75rem;
        }

        .brand-text {
            font-size: .9rem;
        }

        .login-form-panel {
            padding:
                35px 25px;
        }

        .login-heading {
            font-size: 1.65rem;
        }
    }
</style>


<div class="login-page">

    <div class="login-container">


        <!-- ============================================
             PANEL IZQUIERDO
             ============================================ -->

        <section class="login-brand">

            <span class="login-decoration
                         decoration-1">
            </span>


            <span class="login-decoration
                         decoration-2">
            </span>


            <span class="decoration-plus">
                +
            </span>


            <div class="brand-content">


                <span class="brand-badge">

                    Sistema de Gestión de Microcréditos

                </span>


                <h1 class="brand-title">

                    ¡Bienvenido a SIGEMIC!

                </h1>


                <p class="brand-text">

                    Una plataforma diseñada para
                    centralizar y facilitar la gestión
                    de microcréditos, clientes, cuotas,
                    pagos y seguimiento financiero
                    en un solo lugar.

                </p>


            </div>

        </section>



        <!-- ============================================
             PANEL DERECHO
             ============================================ -->

        <section class="login-form-panel">


            <div class="sigemic-small">

                SIGEMIC

            </div>


            <h2 class="login-heading">

                Iniciar sesión

            </h2>


            <p class="login-subtitle">

                Ingresa tus credenciales
                para acceder al sistema.

            </p>


            <form asp-controller="Account"
                  asp-action="Login"
                  method="post"
                  autocomplete="off">


                @Html.AntiForgeryToken()


                <div asp-validation-summary="ModelOnly"
                     class="validation-summary-errors">
                </div>



                <!-- ====================================
                     USUARIO
                     ==================================== -->

                <div class="mb-3">

                    <label asp-for="Username"
                           class="login-form-label">

                        Usuario

                    </label>


                    <div class="login-input-group">


                        <svg class="input-icon"
                             xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor"
                             stroke-width="1.8">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M15.75 6a3.75 3.75 0 11-7.5 0
                                     3.75 3.75 0 017.5 0z
                                     M4.501 20.118a7.5 7.5 0
                                     0114.998 0A17.933 17.933 0
                                     0112 21.75c-2.676 0-5.216-.584
                                     -7.499-1.632z" />

                        </svg>


                        <input asp-for="Username"
                               class="form-control
                                      login-input"
                               placeholder="Ingresa tu usuario"
                               autocomplete="username"
                               autofocus />


                    </div>


                    <span asp-validation-for="Username"
                          class="field-validation-error">
                    </span>

                </div>



                <!-- ====================================
                     CONTRASEÑA
                     ==================================== -->

                <div class="mb-2">

                    <label asp-for="Password"
                           class="login-form-label">

                        Contraseña

                    </label>


                    <div class="login-input-group">


                        <svg class="input-icon"
                             xmlns="http://www.w3.org/2000/svg"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor"
                             stroke-width="1.8">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M16.5 10.5V6.75a4.5 4.5
                                     0 10-9 0v3.75
                                     M6.75 10.5h10.5A2.25
                                     2.25 0 0119.5 12.75v6A2.25
                                     2.25 0 0117.25 21H6.75A2.25
                                     2.25 0 014.5 18.75v-6A2.25
                                     2.25 0 016.75 10.5z" />

                        </svg>


                        <input asp-for="Password"
                               class="form-control
                                      login-input"
                               placeholder="Ingresa tu contraseña"
                               autocomplete="current-password" />


                        <button type="button"
                                class="password-toggle"
                                id="btnMostrarPassword"
                                title="Mostrar contraseña">


                            <svg width="18"
                                 height="18"
                                 xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor"
                                 stroke-width="1.8">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M2.036 12.322a1.012
                                         1.012 0 010-.639C3.423
                                         7.51 7.36 4.5 12 4.5c4.638
                                         0 8.573 3.007 9.963
                                         7.178.07.207.07.431 0
                                         .638C20.577 16.49 16.64
                                         19.5 12 19.5c-4.638
                                         0-8.573-3.007-9.964
                                         -7.178z" />

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M15 12a3 3 0 11-6 0
                                         3 3 0 016 0z" />

                            </svg>


                        </button>


                    </div>


                    <span asp-validation-for="Password"
                          class="field-validation-error">
                    </span>

                </div>



                <!-- ====================================
                     OLVIDÉ CONTRASEÑA
                     ==================================== -->

                <div class="text-end mb-3">

                    <a asp-controller="Recuperacion"
                       asp-action="OlvidePassword"
                       class="forgot-password">

                        ¿Olvidaste tu contraseña?

                    </a>

                </div>



                <!-- ====================================
                     BOTÓN
                     ==================================== -->

                <div class="d-grid">

                    <button type="submit"
                            class="btn
                                   btn-primary
                                   login-button">

                        Iniciar sesión

                    </button>

                </div>


            </form>



            <!-- ============================================
                 TEXTO INFERIOR
                 ============================================ -->

            <div class="security-note">

                Acceso seguro al Sistema
                de Gestión de Microcréditos.

            </div>


        </section>


    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const password =
                    document.getElementById(
                        "Password"
                    );

                const boton =
                    document.getElementById(
                        "btnMostrarPassword"
                    );


                if (!password || !boton) {
                    return;
                }


                boton.addEventListener(
                    "click",
                    function () {

                        if (
                            password.type ===
                            "password"
                        ) {
                            password.type =
                                "text";

                            boton.title =
                                "Ocultar contraseña";
                        }
                        else {
                            password.type =
                                "password";

                            boton.title =
                                "Mostrar contraseña";
                        }

                    }
                );

            }
        );

    </script>

}
@model IEnumerable<SIGEMIC.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container mt-4 mb-5">


    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->

    <div class="d-flex
                justify-content-between
                align-items-center
                flex-wrap
                gap-3
                mb-4">

        <div>

            <h2 class="mb-1">
                Administración de usuarios
            </h2>

            <p class="text-muted mb-0">
                Crea y administra cajeros y
                administradores con acceso a SIGEMIC.
            </p>

        </div>


        <a asp-controller="Usuarios"
           asp-action="Create"
           class="btn btn-primary">

            + Agregar nuevo usuario

        </a>

    </div>


    <!-- =====================================================
         MENSAJES
         ===================================================== -->

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">

            @TempData["Exito"]

        </div>
    }


    <!-- =====================================================
         TABLA
         ===================================================== -->

    <div class="card shadow-sm">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center
                            text-muted
                            py-4">

                    No hay usuarios registrados.

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table
                                  align-middle
                                  mb-0">

                        <thead>

                            <tr>

                                <th>
                                    Nombre
                                </th>

                                <th>
                                    Usuario
                                </th>

                                <th>
                                    Rol
                                </th>

                                <th>
                                    Estado
                                </th>

                                <th>
                                    Último acceso
                                </th>

                                <th class="text-end">
                                    Acciones
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                        @foreach (var usuario in Model)
                        {
                            <tr>

                                <!-- NOMBRE -->

                                <td>

                                    <strong>

                                        @usuario.Nombres
                                        @usuario.Apellidos

                                    </strong>

                                </td>


                                <!-- USERNAME -->

                                <td>

                                    @usuario.Username

                                </td>


                                <!-- ROL -->

                                <td>

                                    @if (
                                        usuario.Rol ==
                                        "ADMINISTRADOR"
                                    )
                                    {
                                        <span class="badge bg-primary">

                                            ADMINISTRADOR

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">

                                            CAJERO

                                        </span>
                                    }

                                </td>


                                <!-- ESTADO -->

                                <td>

                                    @if (
                                        usuario.Estado ==
                                        "ACTIVO"
                                    )
                                    {
                                        <span class="badge bg-success">

                                            ACTIVO

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            INACTIVO

                                        </span>
                                    }

                                </td>


                                <!-- ÚLTIMO ACCESO -->

                                <td>

                                    @if (
                                        usuario.UltimoAcceso.HasValue
                                    )
                                    {
                                        @(
                                            usuario
                                                .UltimoAcceso
                                                .Value
                                                .ToString(
                                                    "dd/MM/yyyy HH:mm"
                                                )
                                        )
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            Sin acceso

                                        </span>
                                    }

                                </td>


                                <!-- ACCIONES -->

                                <td class="text-end">

                                    <div class="d-flex
                                                justify-content-end
                                                flex-wrap
                                                gap-1">


                                        @if (
                                            usuario.Rol ==
                                            "CAJERO"
                                        )
                                        {
                                            <a asp-controller="Usuarios"
                                               asp-action="Permisos"
                                               asp-route-id="@usuario.IdUsuario"
                                               class="btn
                                                      btn-sm
                                                      btn-outline-primary">

                                                Permisos

                                            </a>
                                        }


                                        <a asp-controller="Usuarios"
                                           asp-action="Edit"
                                           asp-route-id="@usuario.IdUsuario"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-secondary">

                                            Editar

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>
@model IEnumerable<SIGEMIC.Models.Usuario>

@{
    ViewData["Title"] = "Cajeros";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Administración de cajeros</h2>
            <p class="text-muted mb-0">Crea usuarios cajeros y administra sus accesos.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Nuevo cajero</a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Usuario</th>
                            <th>Estado</th>
                            <th>Último acceso</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usuario in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@usuario.Nombres @usuario.Apellidos</strong><br />
                                    <small class="text-muted">Cajero</small>
                                </td>
                                <td>@usuario.Username</td>
                                <td>
                                    @if (usuario.Estado == "ACTIVO")
                                    {
                                        <span class="badge bg-success">ACTIVO</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">INACTIVO</span>
                                    }
                                </td>
                                <td>
                                    @(usuario.UltimoAcceso.HasValue
                                        ? usuario.UltimoAcceso.Value.ToString("dd/MM/yyyy HH:mm")
                                        : "Sin acceso")
                                </td>
                                <td class="text-end">
                                    <a asp-action="Permisos"
                                       asp-route-id="@usuario.IdUsuario"
                                       class="btn btn-outline-primary btn-sm">
                                        Permisos
                                    </a>
                                    <a asp-action="Edit"
                                       asp-route-id="@usuario.IdUsuario"
                                       class="btn btn-outline-secondary btn-sm">
                                        Editar
                                    </a>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    No hay cajeros registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
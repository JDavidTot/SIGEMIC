@model SIGEMIC.ViewModels.EditarUsuarioViewModel

@{
    ViewData["Title"] = "Editar usuario";
}

<div class="container mt-4 mb-5">

    <div class="mb-4">

        <h2 class="mb-1">
            Editar usuario
        </h2>

        <p class="text-muted mb-0">
            Actualiza la información y
            el estado de la cuenta.
        </p>

    </div>


    <form asp-controller="Usuarios"
          asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()


        <input asp-for="IdUsuario"
               type="hidden" />

        <input asp-for="Rol"
               type="hidden" />


        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>


        <div class="row g-4">


            <!-- =================================================
                 INFORMACIÓN
                 ================================================= -->

            <div class="col-lg-8">

                <div class="card shadow-sm">

                    <div class="card-header">

                        <strong>
                            Información del usuario
                        </strong>

                    </div>


                    <div class="card-body">

                        <div class="row g-3">


                            <!-- NOMBRES -->

                            <div class="col-md-6">

                                <label asp-for="Nombres"
                                       class="form-label">
                                </label>

                                <input asp-for="Nombres"
                                       class="form-control" />

                                <span asp-validation-for="Nombres"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- APELLIDOS -->

                            <div class="col-md-6">

                                <label asp-for="Apellidos"
                                       class="form-label">
                                </label>

                                <input asp-for="Apellidos"
                                       class="form-control" />

                                <span asp-validation-for="Apellidos"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- USERNAME -->

                            <div class="col-md-6">

                                <label asp-for="Username"
                                       class="form-label">
                                </label>

                                <input asp-for="Username"
                                       class="form-control" />

                                <span asp-validation-for="Username"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- CORREO -->

                            <div class="col-md-6">

                                <label asp-for="Correo"
                                       class="form-label">
                                </label>

                                <input asp-for="Correo"
                                       type="email"
                                       class="form-control"
                                       autocomplete="email" />

                                <span asp-validation-for="Correo"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- NUEVA CONTRASEÑA -->

                            <div class="col-md-6">

                                <label asp-for="NuevaContrasena"
                                       class="form-label">
                                </label>

                                <input asp-for="NuevaContrasena"
                                       type="password"
                                       class="form-control"
                                       autocomplete="new-password" />

                                <div class="form-text">

                                    Déjalo vacío para
                                    conservar la contraseña
                                    actual.

                                </div>

                                <span asp-validation-for="NuevaContrasena"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- ESTADO -->

                            <div class="col-md-6">

                                <label asp-for="Estado"
                                       class="form-label">
                                </label>

                                <select asp-for="Estado"
                                        class="form-select">

                                    <option value="ACTIVO">
                                        ACTIVO
                                    </option>

                                    <option value="INACTIVO">
                                        INACTIVO
                                    </option>

                                </select>

                                <span asp-validation-for="Estado"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 ROL
                 ================================================= -->

            <div class="col-lg-4">

                <div class="card shadow-sm">

                    <div class="card-header">

                        <strong>
                            Nivel de acceso
                        </strong>

                    </div>


                    <div class="card-body">


                        <div class="mb-3">

                            <small class="text-muted">
                                Rol
                            </small>


                            <div class="mt-1">

                                @if (
                                    Model.Rol ==
                                    "ADMINISTRADOR"
                                )
                                {
                                    <span class="badge
                                                 bg-primary
                                                 fs-6">

                                        ADMINISTRADOR

                                    </span>
                                }
                                else
                                {
                                    <span class="badge
                                                 bg-info
                                                 text-dark
                                                 fs-6">

                                        CAJERO

                                    </span>
                                }

                            </div>

                        </div>


                        @if (
                            Model.Rol ==
                            "ADMINISTRADOR"
                        )
                        {
                            <div class="alert
                                        alert-info
                                        mb-0">

                                Este usuario tiene acceso
                                completo a todos los módulos
                                de SIGEMIC.

                            </div>
                        }
                        else
                        {
                            <p class="text-muted">

                                Los permisos específicos
                                del cajero se administran
                                por separado.

                            </p>


                            <a asp-controller="Usuarios"
                               asp-action="Permisos"
                               asp-route-id="@Model.IdUsuario"
                               class="btn
                                      btn-outline-primary
                                      w-100">

                                Administrar permisos

                            </a>
                        }

                    </div>

                </div>

            </div>

        </div>


        <div class="d-flex
                    gap-2
                    mt-4">

            <button type="submit"
                    class="btn btn-primary">

                Guardar cambios

            </button>


            <a asp-controller="Usuarios"
               asp-action="Index"
               class="btn
                      btn-outline-secondary">

                Cancelar

            </a>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}
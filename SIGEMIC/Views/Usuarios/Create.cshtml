@model SIGEMIC.ViewModels.CrearUsuarioViewModel

@{
    ViewData["Title"] = "Nuevo usuario";

    var grupos =
        Model.Permisos
            .Select(
                (permiso, indice) =>
                    new
                    {
                        Permiso = permiso,
                        Indice = indice
                    }
            )
            .GroupBy(x =>
                x.Permiso.Modulo
            );
}

<div class="container mt-4 mb-5">


    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->

    <div class="mb-4">

        <h2 class="mb-1">
            Nuevo usuario
        </h2>

        <p class="text-muted mb-0">
            Registra un nuevo usuario y define
            su nivel de acceso a SIGEMIC.
        </p>

    </div>


    <form asp-controller="Usuarios"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()


        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>


        <!-- =================================================
             INFORMACIÓN
             ================================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                <strong>
                    Información del usuario
                </strong>

            </div>


            <div class="card-body">

                <div class="row g-3">


                    <!-- NOMBRES -->

                    <div class="col-md-6">

                        <label asp-for="Nombres"
                               class="form-label">
                        </label>

                        <input asp-for="Nombres"
                               class="form-control" />

                        <span asp-validation-for="Nombres"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- APELLIDOS -->

                    <div class="col-md-6">

                        <label asp-for="Apellidos"
                               class="form-label">
                        </label>

                        <input asp-for="Apellidos"
                               class="form-control" />

                        <span asp-validation-for="Apellidos"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- USUARIO -->

                    <div class="col-md-6">

                        <label asp-for="Username"
                               class="form-label">
                        </label>

                        <input asp-for="Username"
                               class="form-control"
                               autocomplete="off" />

                        <span asp-validation-for="Username"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- CORREO -->

                    <div class="col-md-6">

                        <label asp-for="Correo"
                               class="form-label">
                        </label>

                        <input asp-for="Correo"
                               type="email"
                               class="form-control"
                               placeholder="ejemplo@correo.com"
                               autocomplete="email" />

                        <span asp-validation-for="Correo"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- CONTRASEÑA -->

                    <div class="col-md-6">

                        <label asp-for="Contrasena"
                               class="form-label">
                        </label>

                        <input asp-for="Contrasena"
                               type="password"
                               class="form-control"
                               autocomplete="new-password" />

                        <div class="form-text">
                            Debe contener al menos
                            8 caracteres.
                        </div>

                        <span asp-validation-for="Contrasena"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ESTADO -->

                    <div class="col-md-6">

                        <label asp-for="Estado"
                               class="form-label">
                        </label>

                        <select asp-for="Estado"
                                class="form-select">

                            <option value="ACTIVO">
                                ACTIVO
                            </option>

                            <option value="INACTIVO">
                                INACTIVO
                            </option>

                        </select>

                        <span asp-validation-for="Estado"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ROL -->

                    <div class="col-md-6">

                        <label asp-for="Rol"
                               class="form-label">
                        </label>

                        <select asp-for="Rol"
                                id="selectorRol"
                                class="form-select">

                            <option value="">
                                Seleccione un rol
                            </option>

                            <option value="CAJERO">
                                CAJERO
                            </option>

                            <option value="ADMINISTRADOR">
                                ADMINISTRADOR
                            </option>

                        </select>

                        <span asp-validation-for="Rol"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             MENSAJE SIN ROL
             ================================================= -->

        <div id="sinRol"
             class="alert
                    alert-light
                    border
                    mb-4">

            Selecciona un rol para definir
            el nivel de acceso del usuario.

        </div>


        <!-- =================================================
             ADMINISTRADOR
             ================================================= -->

        <div id="accesoAdministrador"
             class="card
                    shadow-sm
                    border-primary
                    mb-4"
             style="display:none;">

            <div class="card-header
                        bg-primary
                        text-white">

                <strong>
                    Acceso administrativo
                </strong>

            </div>


            <div class="card-body">

                <h5>
                    Acceso completo a SIGEMIC
                </h5>


                <p class="text-muted mb-2">

                    Los usuarios con rol
                    <strong>ADMINISTRADOR</strong>
                    tienen acceso completo a todos
                    los módulos y funciones del sistema.

                </p>


                <div class="alert
                            alert-info
                            mb-0">

                    No es necesario seleccionar
                    permisos manualmente.
                    Los administradores reciben
                    acceso total automáticamente
                    mediante su rol.

                </div>

            </div>

        </div>


        <!-- =================================================
             PERMISOS DEL CAJERO
             ================================================= -->

        <div id="permisosCajero"
             style="display:none;">


            <div class="mb-3">

                <h3 class="h4 mb-1">
                    Permisos iniciales
                </h3>

                <p class="text-muted mb-0">
                    Selecciona las funciones
                    que podrá utilizar el cajero.
                </p>

            </div>


            <div class="alert
                        alert-light
                        border">

                Los permisos principales
                se marcarán automáticamente
                cuando selecciones una función
                que dependa de ellos.

            </div>


            @foreach (var grupo in grupos)
            {
                <div class="card
                            shadow-sm
                            mb-3">

                    <div class="card-header">

                        <strong>
                            @grupo.Key
                        </strong>

                    </div>


                    <div class="card-body">

                        @foreach (
                            var elemento
                            in grupo
                        )
                        {
                            int i =
                                elemento.Indice;

                            var permiso =
                                elemento.Permiso;


                            <input type="hidden"
                                   asp-for="Permisos[i].IdPermiso" />

                            <input type="hidden"
                                   asp-for="Permisos[i].Codigo" />

                            <input type="hidden"
                                   asp-for="Permisos[i].Nombre" />

                            <input type="hidden"
                                   asp-for="Permisos[i].Descripcion" />

                            <input type="hidden"
                                   asp-for="Permisos[i].Modulo" />


                            <div class="form-check mb-3">

                                <input asp-for="Permisos[i].Seleccionado"
                                       class="form-check-input permiso-check"
                                       data-codigo="@permiso.Codigo" />


                                <label class="form-check-label"
                                       asp-for="Permisos[i].Seleccionado">

                                    <strong>
                                        @permiso.Nombre
                                    </strong>

                                    @if (
                                        !string.IsNullOrWhiteSpace(
                                            permiso.Descripcion
                                        )
                                    )
                                    {
                                        <div class="text-muted small">

                                            @permiso.Descripcion

                                        </div>
                                    }

                                </label>

                            </div>
                        }

                    </div>

                </div>
            }

        </div>


        <!-- =================================================
             BOTONES
             ================================================= -->

        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-primary">

                Crear usuario

            </button>


            <a asp-controller="Usuarios"
               asp-action="Index"
               class="btn btn-outline-secondary">

                Cancelar

            </a>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const selectorRol =
                    document.getElementById(
                        "selectorRol"
                    );

                const permisosCajero =
                    document.getElementById(
                        "permisosCajero"
                    );

                const accesoAdministrador =
                    document.getElementById(
                        "accesoAdministrador"
                    );

                const sinRol =
                    document.getElementById(
                        "sinRol"
                    );


                function actualizarRol() {

                    const rol =
                        selectorRol.value;


                    permisosCajero.style.display =
                        rol === "CAJERO"
                            ? "block"
                            : "none";


                    accesoAdministrador.style.display =
                        rol === "ADMINISTRADOR"
                            ? "block"
                            : "none";


                    sinRol.style.display =
                        rol === ""
                            ? "block"
                            : "none";
                }


                selectorRol.addEventListener(
                    "change",
                    actualizarRol
                );


                actualizarRol();


                // =============================================
                // DEPENDENCIAS DE PERMISOS
                // =============================================

                const dependencias = {

                    "CLIENTES_CREAR":
                        "CLIENTES_VER",

                    "CLIENTES_EDITAR":
                        "CLIENTES_VER",

                    "CLIENTES_CAMBIAR_ESTADO":
                        "CLIENTES_VER",

                    "CREDITOS_CREAR":
                        "CREDITOS_VER",

                    "CREDITOS_DETALLE":
                        "CREDITOS_VER",

                    "PAGOS_ABONO_CAPITAL":
                        "PAGOS_REGISTRAR",

                    "SOLICITUDES_APROBAR":
                        "SOLICITUDES_VER",

                    "SOLICITUDES_RECHAZAR":
                        "SOLICITUDES_VER"
                };


                const checks =
                    Array.from(
                        document.querySelectorAll(
                            ".permiso-check"
                        )
                    );


                function obtenerCheck(
                    codigo
                ) {
                    return checks.find(
                        x =>
                            x.dataset.codigo ===
                            codigo
                    );
                }


                checks.forEach(
                    check => {

                        check.addEventListener(
                            "change",
                            function () {

                                const codigo =
                                    this.dataset.codigo;


                                // =================================
                                // SI SE MARCA UN HIJO,
                                // MARCAR PADRE
                                // =================================

                                if (
                                    this.checked &&
                                    dependencias[codigo]
                                )
                                {
                                    const padre =
                                        obtenerCheck(
                                            dependencias[codigo]
                                        );


                                    if (padre) {
                                        padre.checked =
                                            true;
                                    }
                                }


                                // =================================
                                // EVITAR DESMARCAR PADRE
                                // SI HAY HIJOS SELECCIONADOS
                                // =================================

                                if (!this.checked)
                                {
                                    const hijosActivos =
                                        Object
                                            .entries(
                                                dependencias
                                            )
                                            .filter(
                                                ([hijo, padre]) =>
                                                    padre ===
                                                    codigo
                                            )
                                            .map(
                                                ([hijo]) =>
                                                    obtenerCheck(
                                                        hijo
                                                    )
                                            )
                                            .filter(
                                                hijo =>
                                                    hijo &&
                                                    hijo.checked
                                            );


                                    if (
                                        hijosActivos.length >
                                        0
                                    )
                                    {
                                        this.checked =
                                            true;

                                        alert(
                                            "Este permiso es requerido por otra función seleccionada."
                                        );
                                    }
                                }

                            }
                        );

                    }
                );

            }
        );

    </script>

}
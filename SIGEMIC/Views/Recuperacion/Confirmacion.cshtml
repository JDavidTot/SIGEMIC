@{
    ViewData["Title"] =
        "Solicitud recibida";
}


<div class="container mt-5">

    <div class="row
                justify-content-center">

        <div class="col-md-6">

            <div class="card
                        shadow-sm
                        border-0">

                <div class="card-body
                            text-center
                            p-5">


                    <div class="fs-1 mb-3">
                        ✉
                    </div>


                    <h3>
                        Revisa tu correo
                    </h3>


                    <p class="text-muted">

                        Si la cuenta existe y tiene
                        un correo electrónico asociado,
                        recibirás las instrucciones para
                        restablecer tu contraseña.

                    </p>


                    <p class="small text-muted">

                        El enlace de recuperación será
                        válido durante 30 minutos.

                    </p>


                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-primary">

                        Volver al inicio de sesión

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
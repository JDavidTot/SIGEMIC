@model SIGEMIC.ViewModels.OlvidePasswordViewModel

@{
    ViewData["Title"] =
        "Recuperar contraseña";
}


<div class="container mt-5">

    <div class="row
                justify-content-center">

        <div class="col-md-6
                    col-lg-5">

            <div class="card
                        shadow-sm
                        border-0">

                <div class="card-body p-4">


                    <h3 class="mb-2">
                        Recuperar contraseña
                    </h3>


                    <p class="text-muted">
                        Ingresa tu nombre de usuario.
                        Si la cuenta tiene un correo
                        registrado, enviaremos las
                        instrucciones de recuperación.
                    </p>


                    <form asp-controller="Recuperacion"
                          asp-action="OlvidePassword"
                          method="post">

                        @Html.AntiForgeryToken()


                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <div class="mb-3">

                            <label asp-for="Usuario"
                                   class="form-label">
                            </label>


                            <input asp-for="Usuario"
                                   class="form-control"
                                   autocomplete="username"
                                   autofocus />


                            <span asp-validation-for="Usuario"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="d-grid gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                Enviar instrucciones

                            </button>


                            <a asp-controller="Account"
                               asp-action="Login"
                               class="btn
                                      btn-outline-secondary">

                                Volver al inicio de sesión

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}
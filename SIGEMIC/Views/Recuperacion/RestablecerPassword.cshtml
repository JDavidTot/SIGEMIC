@model SIGEMIC.ViewModels.RestablecerPasswordViewModel

@{
    ViewData["Title"] =
        "Nueva contraseña";
}


<div class="container mt-5">

    <div class="row
                justify-content-center">

        <div class="col-md-6
                    col-lg-5">

            <div class="card
                        shadow-sm
                        border-0">

                <div class="card-body p-4">


                    <h3 class="mb-2">
                        Crear nueva contraseña
                    </h3>


                    <p class="text-muted">

                        Ingresa la nueva contraseña
                        que utilizarás para acceder
                        a SIGEMIC.

                    </p>


                    <form asp-controller="Recuperacion"
                          asp-action="RestablecerPassword"
                          method="post">

                        @Html.AntiForgeryToken()


                        <input asp-for="Token"
                               type="hidden" />


                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <div class="mb-3">

                            <label asp-for="NuevaContrasena"
                                   class="form-label">
                            </label>


                            <input asp-for="NuevaContrasena"
                                   class="form-control"
                                   autocomplete="new-password" />


                            <span asp-validation-for="NuevaContrasena"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="ConfirmarContrasena"
                                   class="form-label">
                            </label>


                            <input asp-for="ConfirmarContrasena"
                                   class="form-control"
                                   autocomplete="new-password" />


                            <span asp-validation-for="ConfirmarContrasena"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="d-grid">

                            <button type="submit"
                                    class="btn btn-primary">

                                Actualizar contraseña

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}
@{
    ViewData["Title"] =
        "Contraseña actualizada";
}


<div class="container mt-5">

    <div class="row
                justify-content-center">

        <div class="col-md-6">

            <div class="card
                        shadow-sm
                        border-0">

                <div class="card-body
                            text-center
                            p-5">


                    <div class="fs-1 mb-3">
                        ✓
                    </div>


                    <h3>
                        Contraseña actualizada
                    </h3>


                    <p class="text-muted">

                        Tu contraseña fue restablecida
                        correctamente. Ya puedes iniciar
                        sesión con la nueva contraseña.

                    </p>


                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-primary">

                        Iniciar sesión

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
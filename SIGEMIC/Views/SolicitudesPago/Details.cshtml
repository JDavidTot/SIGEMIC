@model SIGEMIC.Models.SolicitudPago
@using System.Security.Claims
@inject SIGEMIC.Services.PermisoService PermisoService

@{
    ViewData["Title"] = "Detalle de solicitud";

    bool puedeAprobar = User.IsInRole("ADMINISTRADOR");
    bool puedeRechazar = User.IsInRole("ADMINISTRADOR");
    bool puedeVerCredito = User.IsInRole("ADMINISTRADOR");

    if (User.IsInRole("CAJERO"))
    {
        var idTexto = User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (uint.TryParse(idTexto, out uint idUsuario))
        {
            var permisos = (await PermisoService.ObtenerPermisosAsync(idUsuario))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            puedeAprobar = permisos.Contains("SOLICITUDES_APROBAR");
            puedeRechazar = permisos.Contains("SOLICITUDES_RECHAZAR");
            puedeVerCredito = permisos.Contains("CREDITOS_DETALLE");
        }
    }

    bool pendiente = Model.Estado == "PENDIENTE";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h2 class="mb-1">
                Solicitud #@Model.IdSolicitud
            </h2>

            <p class="text-muted mb-0">
                Registrada el
                @Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")
            </p>
        </div>

        <a asp-controller="SolicitudesPago"
           asp-action="Index"
           class="btn btn-secondary">
            Volver
        </a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Exito"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">
                        Estado
                    </small>

                    <div class="mt-2">
                        @if (Model.Estado == "PENDIENTE")
                        {
                            <span class="badge bg-warning text-dark fs-6">
                                PENDIENTE
                            </span>
                        }
                        else if (Model.Estado == "APROBADA")
                        {
                            <span class="badge bg-success fs-6">
                                APROBADA
                            </span>
                        }
                        else if (Model.Estado == "RECHAZADA")
                        {
                            <span class="badge bg-danger fs-6">
                                RECHAZADA
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">
                                @Model.Estado
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">
                        Tipo de operación
                    </small>

                    <div class="mt-2">
                        @if (Model.TipoOperacion == "PAGO_CUOTA")
                        {
                            <span class="badge bg-primary fs-6">
                                PAGO DE CUOTA
                            </span>
                        }
                        else if (Model.TipoOperacion == "ABONO_EXTRAORDINARIO")
                        {
                            <span class="badge bg-success fs-6">
                                ABONO A CAPITAL
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">
                                @Model.TipoOperacion
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">
                        Monto solicitado
                    </small>

                    <h4 class="mb-0 mt-1">
                        Q @Model.Monto.ToString("N2")
                    </h4>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4">

        <div class="col-lg-6">

            <div class="card shadow-sm h-100">

                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        Información del cliente
                    </h5>
                </div>

                <div class="card-body">

                    <dl class="row mb-0">

                        <dt class="col-sm-5">
                            Código
                        </dt>

                        <dd class="col-sm-7">
                            @Model.Cliente.CodigoCliente
                        </dd>

                        <dt class="col-sm-5">
                            Cliente
                        </dt>

                        <dd class="col-sm-7">
                            @Model.Cliente.Usuario.Nombres
                            @Model.Cliente.Usuario.Apellidos
                        </dd>

                        <dt class="col-sm-5">
                            Crédito
                        </dt>

                        <dd class="col-sm-7">

                            @if (puedeVerCredito)
                            {
                                <a asp-controller="Creditos"
                                   asp-action="Details"
                                   asp-route-id="@Model.IdCredito">
                                    @Model.Credito.CodigoCredito
                                </a>
                            }
                            else
                            {
                                @Model.Credito.CodigoCredito
                            }

                        </dd>

                        @if (Model.Cuota != null)
                        {
                            <dt class="col-sm-5">
                                Cuota
                            </dt>

                            <dd class="col-sm-7">
                                #@Model.Cuota.NumeroCuota
                            </dd>
                        }

                    </dl>

                </div>
            </div>

        </div>

        <div class="col-lg-6">

            <div class="card shadow-sm h-100">

                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        Información del depósito
                    </h5>
                </div>

                <div class="card-body">

                    <dl class="row mb-0">

                        <dt class="col-sm-5">
                            Banco
                        </dt>

                        <dd class="col-sm-7">
                            @(Model.Banco != null
                                ? Model.Banco.Nombre
                                : "No registrado")
                        </dd>

                        <dt class="col-sm-5">
                            Número de boleta
                        </dt>

                        <dd class="col-sm-7">
                            @Model.NumeroBoleta
                        </dd>

                        <dt class="col-sm-5">
                            Monto
                        </dt>

                        <dd class="col-sm-7">
                            <strong>
                                Q @Model.Monto.ToString("N2")
                            </strong>
                        </dd>

                        <dt class="col-sm-5">
                            Comprobante
                        </dt>

                        <dd class="col-sm-7">
                            <a asp-controller="SolicitudesPago"
                               asp-action="VerComprobante"
                               asp-route-id="@Model.IdSolicitud"
                               class="btn btn-outline-primary btn-sm"
                               target="_blank">
                                Ver comprobante
                            </a>
                        </dd>

                    </dl>

                </div>
            </div>

        </div>

    </div>

    @if (Model.Estado == "APROBADA")
    {
        <div class="card shadow-sm mt-4 border-success">

            <div class="card-header bg-success text-white">
                Solicitud aprobada
            </div>

            <div class="card-body">

                <dl class="row mb-0">

                    @if (Model.Pago != null)
                    {
                        <dt class="col-sm-3">
                            Recibo generado
                        </dt>

                        <dd class="col-sm-9">
                            <strong>
                                @Model.Pago.NumeroRecibo
                            </strong>
                        </dd>
                    }

                    @if (Model.UsuarioRevision != null)
                    {
                        <dt class="col-sm-3">
                            Revisada por
                        </dt>

                        <dd class="col-sm-9">
                            @Model.UsuarioRevision.Nombres
                            @Model.UsuarioRevision.Apellidos
                        </dd>
                    }

                    @if (Model.FechaRevision.HasValue)
                    {
                        <dt class="col-sm-3">
                            Fecha de revisión
                        </dt>

                        <dd class="col-sm-9">
                            @Model.FechaRevision.Value.ToString("dd/MM/yyyy HH:mm")
                        </dd>
                    }

                </dl>

            </div>
        </div>
    }

    @if (Model.Estado == "RECHAZADA")
    {
        <div class="card shadow-sm mt-4 border-danger">

            <div class="card-header bg-danger text-white">
                Solicitud rechazada
            </div>

            <div class="card-body">

                <dl class="row mb-0">

                    @if (Model.UsuarioRevision != null)
                    {
                        <dt class="col-sm-3">
                            Revisada por
                        </dt>

                        <dd class="col-sm-9">
                            @Model.UsuarioRevision.Nombres
                            @Model.UsuarioRevision.Apellidos
                        </dd>
                    }

                    @if (Model.FechaRevision.HasValue)
                    {
                        <dt class="col-sm-3">
                            Fecha de revisión
                        </dt>

                        <dd class="col-sm-9">
                            @Model.FechaRevision.Value.ToString("dd/MM/yyyy HH:mm")
                        </dd>
                    }

                    <dt class="col-sm-3">
                        Motivo
                    </dt>

                    <dd class="col-sm-9">
                        @(string.IsNullOrWhiteSpace(Model.MotivoRechazo)
                            ? "Sin motivo registrado."
                            : Model.MotivoRechazo)
                    </dd>

                </dl>

            </div>
        </div>
    }

    @if (pendiente)
    {
        <div class="card shadow-sm mt-4">

            <div class="card-header bg-white">
                <h5 class="mb-0">
                    Revisión de la solicitud
                </h5>
            </div>

            <div class="card-body">

                @if (!puedeAprobar && !puedeRechazar)
                {
                    <div class="alert alert-info mb-0">
                        Tu usuario puede consultar esta solicitud,
                        pero no tiene permiso para aprobarla ni rechazarla.
                    </div>
                }
                else
                {
                    <div class="row g-4">

                        @if (puedeAprobar)
                        {
                            <div class="col-lg-6">

                                <div class="border rounded p-3 h-100">

                                    <h5 class="text-success">
                                        Aprobar solicitud
                                    </h5>

                                    <p class="text-muted">
                                        Al aprobarla, SIGEMIC aplicará el pago
                                        o abono al crédito correspondiente.
                                    </p>

                                    <form asp-controller="SolicitudesPago"
                                          asp-action="Aprobar"
                                          asp-route-id="@Model.IdSolicitud"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-success"
                                                onclick="return confirm('¿Está seguro de aprobar esta solicitud? El pago será aplicado al crédito.');">
                                            Aprobar solicitud
                                        </button>

                                    </form>

                                </div>

                            </div>
                        }

                        @if (puedeRechazar)
                        {
                            <div class="col-lg-6">

                                <div class="border rounded p-3 h-100">

                                    <h5 class="text-danger">
                                        Rechazar solicitud
                                    </h5>

                                    <p class="text-muted">
                                        Debe indicar el motivo por el cual
                                        la solicitud será rechazada.
                                    </p>

                                    <form asp-controller="SolicitudesPago"
                                          asp-action="Rechazar"
                                          asp-route-id="@Model.IdSolicitud"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <div class="mb-3">

                                            <label for="motivoRechazo"
                                                   class="form-label">
                                                Motivo del rechazo
                                            </label>

                                            <textarea id="motivoRechazo"
                                                      name="motivoRechazo"
                                                      class="form-control"
                                                      rows="3"
                                                      maxlength="500"
                                                      required>
                                            </textarea>

                                        </div>

                                        <button type="submit"
                                                class="btn btn-danger"
                                                onclick="return confirm('¿Está seguro de rechazar esta solicitud?');">
                                            Rechazar solicitud
                                        </button>

                                    </form>

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>
        </div>
    }

</div>
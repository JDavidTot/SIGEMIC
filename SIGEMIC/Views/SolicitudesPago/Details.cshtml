@model SIGEMIC.Models.SolicitudPago

@{
    ViewData["Title"] = "Detalle de solicitud";
}


<div class="container py-4">

    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->

    <div class="d-flex justify-content-between
                align-items-center
                flex-wrap
                gap-3
                mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Solicitud #@Model.IdSolicitud
            </h2>

            <p class="text-muted mb-0">
                Enviada el
                @(Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm"))
            </p>

        </div>


        <a asp-action="Index"
           class="btn btn-outline-secondary">

            Regresar

        </a>

    </div>


    <!-- =====================================================
         MENSAJES
         ===================================================== -->

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">

            @TempData["Exito"]

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">

            @TempData["Error"]

        </div>
    }


    <div class="row g-4">


        <!-- =================================================
             COLUMNA IZQUIERDA
             ================================================= -->

        <div class="col-lg-8">


            <!-- =================================================
                 CLIENTE Y CRÉDITO
                 ================================================= -->

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Cliente y crédito
                    </h5>

                </div>


                <div class="card-body">

                    <div class="row g-3">


                        <!-- CLIENTE -->

                        <div class="col-md-6">

                            <small class="text-muted">
                                Cliente
                            </small>

                            <div class="fw-semibold">

                                @Model.Cliente.Usuario.Nombres
                                @Model.Cliente.Usuario.Apellidos

                            </div>

                        </div>


                        <!-- CÓDIGO CLIENTE -->

                        <div class="col-md-6">

                            <small class="text-muted">
                                Código del cliente
                            </small>

                            <div class="fw-semibold">
                                @Model.Cliente.CodigoCliente
                            </div>

                        </div>


                        <!-- CRÉDITO -->

                        <div class="col-md-6">

                            <small class="text-muted">
                                Crédito
                            </small>

                            <div class="fw-semibold">
                                @Model.Credito.CodigoCredito
                            </div>

                        </div>


                        <!-- TIPO DE OPERACIÓN -->

                        <div class="col-md-6">

                            <small class="text-muted">
                                Tipo de operación
                            </small>

                            <div class="fw-semibold">

                                @if (Model.TipoOperacion == "PAGO_CUOTA")
                                {
                                    <span>
                                        Pago de cuota
                                    </span>
                                }

                                @if (Model.TipoOperacion == "ABONO_EXTRAORDINARIO")
                                {
                                    <span>
                                        Abono extraordinario a capital
                                    </span>
                                }

                            </div>

                        </div>


                        <!-- DATOS DE LA CUOTA -->

                        @if (Model.Cuota != null)
                        {
                            <div class="col-md-6">

                                <small class="text-muted">
                                    Cuota
                                </small>

                                <div class="fw-semibold">
                                    #@Model.Cuota.NumeroCuota
                                </div>

                            </div>


                            <div class="col-md-6">

                                <small class="text-muted">
                                    Saldo actual de cuota
                                </small>

                                <div class="fw-semibold">

                                    Q @(Model.Cuota.SaldoCuota.ToString("N2"))

                                </div>

                            </div>
                        }


                        <!-- SALDO DEL CRÉDITO -->

                        <div class="col-md-6">

                            <small class="text-muted">
                                Saldo actual del crédito
                            </small>

                            <div class="fw-semibold">

                                Q @(Model.Credito.SaldoCapital.ToString("N2"))

                            </div>

                        </div>


                        <!-- ESTADO DEL CRÉDITO -->

                        <div class="col-md-6">

                            <small class="text-muted">
                                Estado del crédito
                            </small>

                            <div>

                                @if (Model.Credito.Estado == "ACTIVO")
                                {
                                    <span class="badge bg-success">
                                        ACTIVO
                                    </span>
                                }

                                @if (Model.Credito.Estado == "ATRASADO")
                                {
                                    <span class="badge bg-danger">
                                        ATRASADO
                                    </span>
                                }

                                @if (Model.Credito.Estado == "CANCELADO")
                                {
                                    <span class="badge bg-secondary">
                                        CANCELADO
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 INFORMACIÓN DEL DEPÓSITO
                 ================================================= -->

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Información del depósito
                    </h5>

                </div>


                <div class="card-body">

                    <div class="row g-3">


                        <!-- BANCO -->

                        <div class="col-md-6">

                            <small class="text-muted">
                                Banco
                            </small>

                            <div class="fw-semibold">
                                @Model.Banco.Nombre
                            </div>

                        </div>


                        <!-- CUENTA -->

                        <div class="col-md-6">

                            <small class="text-muted">
                                Número de cuenta
                            </small>

                            <div class="fw-semibold">
                                @Model.Banco.NumeroCuenta
                            </div>

                        </div>


                        <!-- BENEFICIARIO -->

                        <div class="col-md-6">

                            <small class="text-muted">
                                Beneficiario
                            </small>

                            <div class="fw-semibold">
                                @Model.Banco.Beneficiario
                            </div>

                        </div>


                        <!-- TIPO DE CUENTA -->

                        <div class="col-md-6">

                            <small class="text-muted">
                                Tipo de cuenta
                            </small>

                            <div class="fw-semibold">
                                @Model.Banco.TipoCuenta
                            </div>

                        </div>


                        <!-- MONTO -->

                        <div class="col-md-6">

                            <small class="text-muted">
                                Monto reportado
                            </small>

                            <div class="fs-4 fw-bold text-primary">

                                Q @(Model.Monto.ToString("N2"))

                            </div>

                        </div>


                        <!-- NÚMERO DE BOLETA -->

                        <div class="col-md-6">

                            <small class="text-muted">
                                Número de boleta
                            </small>

                            <div class="fw-semibold">
                                @Model.NumeroBoleta
                            </div>

                        </div>

                    </div>


                    <hr />


                    <!-- COMPROBANTE -->

                    <a asp-action="VerComprobante"
                       asp-route-id="@Model.IdSolicitud"
                       target="_blank"
                       class="btn btn-outline-primary">

                        Ver comprobante

                    </a>

                </div>

            </div>


            <!-- =================================================
                 PAGO GENERADO
                 Solo aparece si la solicitud está aprobada
                 ================================================= -->

            @if (Model.Estado == "APROBADA" && Model.Pago != null)
            {
                <div class="card border-success shadow-sm">

                    <div class="card-header bg-white">

                        <h5 class="mb-0 text-success">
                            Pago generado
                        </h5>

                    </div>


                    <div class="card-body">

                        <div class="row g-3">


                            <!-- RECIBO -->

                            <div class="col-md-6">

                                <small class="text-muted">
                                    Número de recibo
                                </small>

                                <div class="fw-bold text-success fs-5">

                                    @Model.Pago.NumeroRecibo

                                </div>

                            </div>


                            <!-- MONTO -->

                            <div class="col-md-6">

                                <small class="text-muted">
                                    Monto aplicado
                                </small>

                                <div class="fw-semibold">

                                    Q @(Model.Pago.MontoTotal.ToString("N2"))

                                </div>

                            </div>


                            <!-- CAPITAL -->

                            <div class="col-md-4">

                                <small class="text-muted">
                                    Capital aplicado
                                </small>

                                <div class="fw-semibold">

                                    Q @(Model.Pago.CapitalAplicado.ToString("N2"))

                                </div>

                            </div>


                            <!-- INTERÉS -->

                            <div class="col-md-4">

                                <small class="text-muted">
                                    Interés aplicado
                                </small>

                                <div class="fw-semibold">

                                    Q @(Model.Pago.InteresAplicado.ToString("N2"))

                                </div>

                            </div>


                            <!-- MORA -->

                            <div class="col-md-4">

                                <small class="text-muted">
                                    Mora aplicada
                                </small>

                                <div class="fw-semibold">

                                    Q @(Model.Pago.MoraAplicada.ToString("N2"))

                                </div>

                            </div>


                            <!-- FECHA -->

                            <div class="col-md-6">

                                <small class="text-muted">
                                    Fecha del pago
                                </small>

                                <div>

                                    @(Model.Pago.FechaPago.ToString("dd/MM/yyyy HH:mm"))

                                </div>

                            </div>


                            <!-- TIPO -->

                            <div class="col-md-6">

                                <small class="text-muted">
                                    Tipo de operación
                                </small>

                                <div class="fw-semibold">

                                    @if (Model.Pago.TipoOperacion == "PAGO_CUOTA")
                                    {
                                        <span>
                                            Pago de cuota
                                        </span>
                                    }

                                    @if (Model.Pago.TipoOperacion == "ABONO_EXTRAORDINARIO")
                                    {
                                        <span>
                                            Abono extraordinario a capital
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>


        <!-- =================================================
             COLUMNA DERECHA
             REVISIÓN
             ================================================= -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Revisión
                    </h5>

                </div>


                <div class="card-body">


                    <!-- =================================================
                         ESTADO ACTUAL
                         ================================================= -->

                    <div class="mb-4">

                        <small class="text-muted d-block mb-2">
                            Estado actual
                        </small>


                        @if (Model.Estado == "PENDIENTE")
                        {
                            <span class="badge bg-warning text-dark fs-6">

                                PENDIENTE

                            </span>
                        }


                        @if (Model.Estado == "APROBADA")
                        {
                            <span class="badge bg-success fs-6">

                                APROBADA

                            </span>
                        }


                        @if (Model.Estado == "RECHAZADA")
                        {
                            <span class="badge bg-danger fs-6">

                                RECHAZADA

                            </span>
                        }

                    </div>


                    <!-- =================================================
                         SOLICITUD PENDIENTE
                         ================================================= -->

                    @if (Model.Estado == "PENDIENTE")
                    {

                        <div class="alert alert-warning">

                            Verifica el banco, número de boleta,
                            monto y comprobante antes de aprobar.

                        </div>


                        <!-- APROBAR -->

                        <form asp-action="Aprobar"
                              method="post"
                              class="mb-4">

                            @Html.AntiForgeryToken()


                            <input type="hidden"
                                   name="id"
                                   value="@Model.IdSolicitud" />


                            <button type="submit"
                                    class="btn btn-success w-100"
                                    onclick="return confirm('¿Está seguro de aprobar esta solicitud y aplicar el pago al crédito?');">

                                Aprobar y aplicar pago

                            </button>

                        </form>


                        <hr />


                        <!-- RECHAZAR -->

                        <form asp-action="Rechazar"
                              method="post">

                            @Html.AntiForgeryToken()


                            <input type="hidden"
                                   name="id"
                                   value="@Model.IdSolicitud" />


                            <div class="mb-3">

                                <label class="form-label fw-semibold">

                                    Motivo del rechazo

                                </label>


                                <textarea name="motivoRechazo"
                                          class="form-control"
                                          rows="4"
                                          maxlength="255"
                                          required
                                          placeholder="Ej. El número de boleta no coincide con el comprobante."></textarea>

                            </div>


                            <button type="submit"
                                    class="btn btn-danger w-100"
                                    onclick="return confirm('¿Está seguro de rechazar esta solicitud?');">

                                Rechazar solicitud

                            </button>

                        </form>

                    }


                    <!-- =================================================
                         SOLICITUD YA REVISADA
                         ================================================= -->

                    @if (Model.Estado != "PENDIENTE")
                    {

                        <!-- USUARIO QUE REVISÓ -->

                        @if (Model.UsuarioRevision != null)
                        {
                            <div class="mb-3">

                                <small class="text-muted">
                                    Revisado por
                                </small>

                                <div class="fw-semibold">

                                    @Model.UsuarioRevision.Nombres
                                    @Model.UsuarioRevision.Apellidos

                                </div>

                            </div>
                        }


                        <!-- FECHA DE REVISIÓN -->

                        @if (Model.FechaRevision.HasValue)
                        {
                            <div class="mb-3">

                                <small class="text-muted">
                                    Fecha de revisión
                                </small>

                                <div>

                                    @(Model.FechaRevision.Value.ToString("dd/MM/yyyy HH:mm"))

                                </div>

                            </div>
                        }


                        <!-- SOLICITUD APROBADA -->

                        @if (Model.Estado == "APROBADA")
                        {
                            <div class="alert alert-success mb-0">

                                <strong>
                                    Solicitud aprobada
                                </strong>

                                <div class="mt-1">

                                    El pago fue aplicado correctamente
                                    al crédito.

                                </div>


                                @if (Model.Pago != null)
                                {
                                    <hr />

                                    <small>
                                        Recibo generado:
                                    </small>

                                    <div class="fw-bold">

                                        @Model.Pago.NumeroRecibo

                                    </div>
                                }

                            </div>
                        }


                        <!-- SOLICITUD RECHAZADA -->

                        @if (Model.Estado == "RECHAZADA")
                        {
                            <div>

                                <small class="text-muted">
                                    Motivo del rechazo
                                </small>


                                <div class="alert alert-danger mt-2 mb-0">

                                    @Model.MotivoRechazo

                                </div>

                            </div>
                        }

                    }

                </div>

            </div>

        </div>

    </div>

</div>
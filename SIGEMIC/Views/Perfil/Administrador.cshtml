@model SIGEMIC.ViewModels.PerfilAdministradorViewModel

@{
    ViewData["Title"] = "Mi perfil";
}

<div class="container mt-4 mb-5">

    <div class="mb-4">

        <h2 class="mb-1">
            Mi perfil
        </h2>

        <p class="text-muted mb-0">
            Consulta la información de tu cuenta
            y configura el correo utilizado para
            recuperación de contraseña.
        </p>

    </div>


    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">

            @TempData["Exito"]

        </div>
    }


    <div class="row g-4">

        <!-- =============================================
             INFORMACIÓN DE LA CUENTA
             ============================================= -->

        <div class="col-lg-5">

            <div class="card shadow-sm h-100">

                <div class="card-header">

                    <strong>
                        Información de la cuenta
                    </strong>

                </div>


                <div class="card-body">

                    <dl class="row mb-0">

                        <dt class="col-sm-5">
                            Nombre
                        </dt>

                        <dd class="col-sm-7">

                            @Model.Nombres
                            @Model.Apellidos

                        </dd>


                        <dt class="col-sm-5">
                            Usuario
                        </dt>

                        <dd class="col-sm-7">

                            @Model.Username

                        </dd>


                        <dt class="col-sm-5">
                            Rol
                        </dt>

                        <dd class="col-sm-7">

                            <span class="badge bg-primary">

                                @Model.Rol

                            </span>

                        </dd>


                        <dt class="col-sm-5">
                            Estado
                        </dt>

                        <dd class="col-sm-7">

                            @if (
                                Model.Estado ==
                                "ACTIVO"
                            )
                            {
                                <span class="badge
                                             bg-success">

                                    ACTIVO

                                </span>
                            }
                            else
                            {
                                <span class="badge
                                             bg-secondary">

                                    @Model.Estado

                                </span>
                            }

                        </dd>

                    </dl>

                </div>

            </div>

        </div>


        <!-- =============================================
             CORREO DE RECUPERACIÓN
             ============================================= -->

        <div class="col-lg-7">

            <div class="card shadow-sm">

                <div class="card-header">

                    <strong>
                        Correo de recuperación
                    </strong>

                </div>


                <div class="card-body">

                    <form asp-controller="Perfil"
                          asp-action="Administrador"
                          method="post">

                        @Html.AntiForgeryToken()


                        <input asp-for="IdUsuario"
                               type="hidden" />

                        <input asp-for="Nombres"
                               type="hidden" />

                        <input asp-for="Apellidos"
                               type="hidden" />

                        <input asp-for="Username"
                               type="hidden" />

                        <input asp-for="Rol"
                               type="hidden" />

                        <input asp-for="Estado"
                               type="hidden" />


                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>


                        <label asp-for="Correo"
                               class="form-label">
                        </label>


                        <input asp-for="Correo"
                               type="email"
                               class="form-control"
                               placeholder="ejemplo@correo.com"
                               autocomplete="email" />


                        <span asp-validation-for="Correo"
                              class="text-danger">
                        </span>


                        <div class="form-text mt-2">

                            Este correo será utilizado
                            para verificar tu identidad
                            cuando solicites recuperar
                            la contraseña.

                        </div>


                        <div class="alert
                                    alert-light
                                    border
                                    mt-4
                                    mb-3">

                            <strong>
                                Importante:
                            </strong>

                            cada cuenta de SIGEMIC debe
                            utilizar una dirección de correo
                            diferente.

                        </div>


                        <button type="submit"
                                class="btn btn-primary">

                            Guardar correo

                        </button>


                        <a asp-controller="Admin"
                           asp-action="Index"
                           class="btn
                                  btn-outline-secondary
                                  ms-1">

                            Volver

                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}
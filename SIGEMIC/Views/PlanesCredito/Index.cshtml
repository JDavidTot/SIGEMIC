@model IEnumerable<SIGEMIC.Models.PlanCredito>

@{
    ViewData["Title"] = "Planes de crédito";
}

<div class="container mt-4">

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["MensajeExito"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>Planes de crédito</h2>

            <p class="text-muted">
                Administración de tasas y productos de microcrédito.
            </p>

        </div>


        <a asp-action="Create"
           class="btn btn-primary">

            Nuevo plan

        </a>

    </div>


    <!-- TABLA -->

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>Nombre</th>

                            <th>Descripción</th>

                            <th>Tipo de tasa</th>

                            <th>Interés</th>

                            <th>Estado</th>

                            <th>Fecha creación</th>

                            <th>Acciones</th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var plan in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @plan.Nombre
                                        </strong>
                                    </td>


                                    <td>
                                        @(string.IsNullOrWhiteSpace(plan.Descripcion)
                                            ? "-"
                                            : plan.Descripcion)
                                    </td>


                                    <td>
                                        @plan.TipoTasa
                                    </td>


                                    <td>
                                        @plan.PorcentajeInteres.ToString("N2") %
                                    </td>


                                    <td>

                                        @if (plan.Estado == "ACTIVO")
                                        {
                                            <span class="badge bg-success">
                                                ACTIVO
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                INACTIVO
                                            </span>
                                        }

                                    </td>


                                    <td>
                                        @plan.FechaCreacion.ToString("dd/MM/yyyy")
                                    </td>


                                    <td>

                                        <!-- EDITAR -->

                                        <a asp-action="Edit"
                                           asp-route-id="@plan.IdPlan"
                                           class="btn btn-sm btn-outline-primary">

                                            Editar

                                        </a>



                                        <form asp-action="CambiarEstado"
                                              asp-route-id="@plan.IdPlan"
                                              method="post"
                                              class="d-inline">

                                            @if (plan.Estado == "ACTIVO")
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">

                                                    Inactivar

                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success">

                                                    Activar

                                                </button>
                                            }

                                        </form>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center text-muted">

                                    No existen planes de crédito registrados.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- VOLVER -->

    <div class="mt-3">

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-secondary">

            Volver al dashboard

        </a>

    </div>

</div>
@model IEnumerable<SIGEMIC.Models.Auditoria>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Auditoría";

    string resultado =
        ViewBag.Resultado ?? string.Empty;

    string desde =
        ViewBag.Desde ?? string.Empty;

    string hasta =
        ViewBag.Hasta ?? string.Empty;

    var usuariosFiltro =
        ViewBag.UsuariosFiltro
        as List<SelectListItem>
        ?? new List<SelectListItem>();

    var accionesFiltro =
        ViewBag.AccionesFiltro
        as List<SelectListItem>
        ?? new List<SelectListItem>();

    int total =
        Model.Count();

    int exitosos =
        Model.Count(a =>
            a.Resultado == "EXITOSO"
        );

    int fallidos =
        Model.Count(a =>
            a.Resultado == "FALLIDO"
        );

    int usuarios =
        Model
            .Where(a =>
                a.IdUsuario.HasValue
            )
            .Select(a =>
                a.IdUsuario
            )
            .Distinct()
            .Count();
}

<style>

    .audit-title {
        font-weight: 700;
    }

    .audit-summary-card {
        border: 0;
        border-radius: 14px;
        transition:
            transform .15s ease,
            box-shadow .15s ease;
    }

    .audit-summary-card:hover {
        transform: translateY(-2px);
    }

    .audit-summary-number {
        font-size: 1.65rem;
        font-weight: 700;
        line-height: 1;
    }

    .filter-card {
        border: 0;
        border-radius: 14px;
    }

    .audit-table-card {
        border: 0;
        border-radius: 14px;
        overflow: hidden;
    }

    .audit-table thead th {
        background: #f8f9fa;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .025rem;
        color: #495057;
        white-space: nowrap;
        padding-top: 14px;
        padding-bottom: 14px;
    }

    .audit-table tbody td {
        vertical-align: top;
        padding-top: 16px;
        padding-bottom: 16px;
    }

    .audit-table tbody tr {
        transition:
            background-color .15s ease;
    }

    .audit-table tbody tr:hover {
        background-color: #f8fbff;
    }

    .audit-date {
        min-width: 125px;
    }

    .audit-user {
        min-width: 125px;
    }

    .audit-action {
        min-width: 180px;
        font-weight: 600;
        color: #212529;
    }

    .audit-ip {
        min-width: 110px;
        font-family: monospace;
        font-size: .82rem;
    }

    .audit-result {
        min-width: 110px;
    }

    .audit-detail {
        min-width: 470px;
        max-width: 720px;
    }

    .audit-operation {
        background: #fbfcfe;
        border: 1px solid #e6eaf0;
        border-radius: 10px;
        padding: 10px;
    }

    .audit-operation-title {
        font-size: .86rem;
        font-weight: 600;
        color: #343a40;
        margin-bottom: 8px;
    }

    .audit-data-grid {
        display: grid;
        grid-template-columns:
            repeat(
                auto-fit,
                minmax(145px, 1fr)
            );
        gap: 7px;
    }

    .audit-data-item {
        background: white;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 7px 9px;
    }

    .audit-data-label {
        display: block;
        font-size: .67rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #6c757d;
        margin-bottom: 2px;
    }

    .audit-data-value {
        font-size: .82rem;
        font-weight: 500;
        color: #212529;
        word-break: break-word;
    }

    .audit-changes-title {
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #6c757d;
        margin-top: 10px;
        margin-bottom: 5px;
    }

    .audit-change {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 9px;
        padding: 7px 9px;
        margin-top: 5px;
    }

    .audit-change-field {
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #6c757d;
        margin-bottom: 4px;
    }

    .audit-value {
        display: inline-flex;
        align-items: center;
        padding: 3px 8px;
        border-radius: 7px;
        font-size: .78rem;
    }

    .audit-value-before {
        background: #fff1f2;
        color: #842029;
        border: 1px solid #f5c2c7;
    }

    .audit-value-after {
        background: #eaf7ef;
        color: #0f5132;
        border: 1px solid #badbcc;
    }

    .audit-arrow {
        font-weight: 700;
        color: #6c757d;
        padding-left: 5px;
        padding-right: 5px;
    }

</style>


<div class="container mt-4">


    <!-- ==============================================
         ENCABEZADO
         ============================================== -->

    <div class="d-flex
                flex-wrap
                justify-content-between
                align-items-center
                gap-3
                mb-4">

        <div>

            <h2 class="audit-title mb-1">

                Auditoría del sistema

            </h2>

            <p class="text-muted mb-0">

                Seguimiento de accesos,
                operaciones y cambios realizados
                en SIGEMIC.

            </p>

        </div>


        <span class="badge
                     rounded-pill
                     bg-dark
                     fs-6
                     px-3
                     py-2">

            @total registros

        </span>

    </div>


    <!-- ==============================================
         RESUMEN
         ============================================== -->

    <div class="row g-3 mb-4">

        <div class="col-6 col-lg-3">

            <div class="card
                        shadow-sm
                        audit-summary-card
                        h-100">

                <div class="card-body">

                    <small class="text-muted">

                        Registros mostrados

                    </small>

                    <div class="audit-summary-number mt-2">

                        @total

                    </div>

                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="card
                        shadow-sm
                        audit-summary-card
                        h-100">

                <div class="card-body">

                    <small class="text-muted">

                        Exitosos

                    </small>

                    <div class="audit-summary-number
                                text-success
                                mt-2">

                        @exitosos

                    </div>

                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="card
                        shadow-sm
                        audit-summary-card
                        h-100">

                <div class="card-body">

                    <small class="text-muted">

                        Fallidos

                    </small>

                    <div class="audit-summary-number
                                text-danger
                                mt-2">

                        @fallidos

                    </div>

                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="card
                        shadow-sm
                        audit-summary-card
                        h-100">

                <div class="card-body">

                    <small class="text-muted">

                        Usuarios involucrados

                    </small>

                    <div class="audit-summary-number
                                text-primary
                                mt-2">

                        @usuarios

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ==============================================
         FILTROS
         ============================================== -->

    <div class="card
                shadow-sm
                filter-card
                mb-4">

        <div class="card-header
                    bg-white">

            <strong>

                Filtros de búsqueda

            </strong>

        </div>


        <div class="card-body">

            <form method="get"
                  asp-controller="Auditoria"
                  asp-action="Index">

                <div class="row g-3">


                    <!-- ===============================
                         USUARIO
                         =============================== -->

                    <div class="col-md-4">

                        <label class="form-label">

                            Usuario

                        </label>

                        <select name="usuario"
                                class="form-select"
                                asp-items="usuariosFiltro">

                            <option value="">

                                Todos los usuarios

                            </option>

                        </select>

                    </div>


                    <!-- ===============================
                         ACCIÓN
                         =============================== -->

                    <div class="col-md-4">

                        <label class="form-label">

                            Acción

                        </label>

                        <select name="accion"
                                class="form-select"
                                asp-items="accionesFiltro">

                            <option value="">

                                Todas las acciones

                            </option>

                        </select>

                    </div>


                    <!-- ===============================
                         RESULTADO
                         =============================== -->

                    <div class="col-md-4">

                        <label class="form-label">

                            Resultado

                        </label>

                        <select name="resultado"
                                class="form-select">

                            <option value="">

                                Todos los resultados

                            </option>


                            @if (
                                resultado ==
                                "EXITOSO"
                            )
                            {
                                <option value="EXITOSO"
                                        selected>

                                    Exitoso

                                </option>
                            }
                            else
                            {
                                <option value="EXITOSO">

                                    Exitoso

                                </option>
                            }


                            @if (
                                resultado ==
                                "FALLIDO"
                            )
                            {
                                <option value="FALLIDO"
                                        selected>

                                    Fallido

                                </option>
                            }
                            else
                            {
                                <option value="FALLIDO">

                                    Fallido

                                </option>
                            }

                        </select>

                    </div>


                    <!-- ===============================
                         DESDE
                         =============================== -->

                    <div class="col-md-3">

                        <label class="form-label">

                            Desde

                        </label>

                        <input type="date"
                               name="desde"
                               value="@desde"
                               class="form-control" />

                    </div>


                    <!-- ===============================
                         HASTA
                         =============================== -->

                    <div class="col-md-3">

                        <label class="form-label">

                            Hasta

                        </label>

                        <input type="date"
                               name="hasta"
                               value="@hasta"
                               class="form-control" />

                    </div>


                    <div class="col-md-6
                                d-flex
                                align-items-end
                                gap-2">

                        <button type="submit"
                                class="btn
                                       btn-primary
                                       px-4">

                            Buscar

                        </button>


                        <a asp-controller="Auditoria"
                           asp-action="Index"
                           class="btn
                                  btn-outline-secondary">

                            Limpiar filtros

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ==============================================
         TABLA
         ============================================== -->

    <div class="card
                shadow-sm
                audit-table-card">

        <div class="card-header
                    bg-white
                    py-3">

            <div class="d-flex
                        justify-content-between
                        align-items-center">

                <strong>

                    Registro de eventos

                </strong>

                <small class="text-muted">

                    Más recientes primero

                </small>

            </div>

        </div>


        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center
                            py-5">

                    <h5>

                        No hay registros

                    </h5>

                    <p class="text-muted mb-0">

                        No se encontraron eventos
                        con los filtros seleccionados.

                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table
                                  table-hover
                                  audit-table
                                  mb-0">

                        <thead>

                            <tr>

                                <th>
                                    Fecha / Hora
                                </th>

                                <th>
                                    Usuario
                                </th>

                                <th>
                                    Acción
                                </th>

                                <th>
                                    IP
                                </th>

                                <th>
                                    Resultado
                                </th>

                                <th>
                                    Detalle de la operación
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                        @foreach (
                            var auditoria in Model
                        )
                        {
                            string descripcion =
                                auditoria.Descripcion
                                ?? string.Empty;


                            // ==============================
                            // SEPARAR CAMBIOS
                            // ==============================

                            int posicionCambios =
                                descripcion.IndexOf(
                                    "Cambios:",
                                    StringComparison
                                        .OrdinalIgnoreCase
                                );

                            bool tieneCambios =
                                posicionCambios >= 0;

                            string operacionTexto =
                                tieneCambios
                                    ? descripcion[
                                        ..posicionCambios
                                      ].Trim()
                                    : descripcion.Trim();

                            string cambiosTexto =
                                tieneCambios
                                    ? descripcion[
                                        (posicionCambios + 8)..
                                      ].Trim()
                                    : string.Empty;


                            // ==============================
                            // NORMALIZAR ALGUNOS CAMPOS
                            // PARA PRESENTACIÓN
                            // ==============================

                            operacionTexto =
                                operacionTexto
                                    .Replace(
                                        ". Crédito:",
                                        "; Crédito:"
                                    )
                                    .Replace(
                                        ". Cliente:",
                                        "; Cliente:"
                                    )
                                    .Replace(
                                        ". Usuario:",
                                        "; Usuario:"
                                    )
                                    .Replace(
                                        ". Rol:",
                                        "; Rol:"
                                    )
                                    .Replace(
                                        ". Nombre:",
                                        "; Nombre:"
                                    )
                                    .Replace(
                                        ". Estado:",
                                        "; Estado:"
                                    );


                            // ==============================
                            // DATOS DE LA OPERACIÓN
                            // ==============================

                            string resumenOperacion =
                                string.Empty;

                            var datosOperacion =
                                new List<
                                    (string Campo,
                                     string Valor)
                                >();


                            if (
                                !string.IsNullOrWhiteSpace(
                                    operacionTexto
                                )
                            )
                            {
                                var segmentos =
                                    operacionTexto.Split(
                                        ';',
                                        StringSplitOptions
                                            .RemoveEmptyEntries |
                                        StringSplitOptions
                                            .TrimEntries
                                    );

                                foreach (
                                    string segmento
                                    in segmentos
                                )
                                {
                                    string texto =
                                        segmento
                                            .Trim()
                                            .TrimEnd('.');

                                    int posicionDosPuntos =
                                        texto.IndexOf(
                                            ':'
                                        );

                                    if (
                                        posicionDosPuntos > 0
                                    )
                                    {
                                        string campo =
                                            texto[
                                                ..posicionDosPuntos
                                            ]
                                            .Trim();

                                        string valor =
                                            texto[
                                                (posicionDosPuntos + 1)..
                                            ]
                                            .Trim();

                                        datosOperacion.Add(
                                            (
                                                campo,
                                                valor
                                            )
                                        );
                                    }
                                    else
                                    {
                                        if (
                                            string.IsNullOrWhiteSpace(
                                                resumenOperacion
                                            )
                                        )
                                        {
                                            resumenOperacion =
                                                texto;
                                        }
                                        else
                                        {
                                            resumenOperacion +=
                                                " " +
                                                texto;
                                        }
                                    }
                                }
                            }


                            // ==============================
                            // CAMBIOS ANTES / DESPUÉS
                            // ==============================

                            string[] cambios =
                                Array.Empty<string>();

                            if (
                                !string.IsNullOrWhiteSpace(
                                    cambiosTexto
                                )
                            )
                            {
                                cambios =
                                    cambiosTexto
                                        .TrimEnd('.')
                                        .Split(
                                            "; ",
                                            StringSplitOptions
                                                .RemoveEmptyEntries
                                        );
                            }


                            <tr>

                                <!-- ======================
                                     FECHA / HORA
                                     ====================== -->

                                <td class="audit-date">

                                    <div class="fw-semibold">

                                        @(
                                            auditoria
                                                .FechaHora
                                                .ToString(
                                                    "dd/MM/yyyy"
                                                )
                                        )

                                    </div>

                                    <div class="small
                                                text-muted">

                                        @(
                                            auditoria
                                                .FechaHora
                                                .ToString(
                                                    "HH:mm:ss"
                                                )
                                        )

                                    </div>

                                </td>


                                <!-- ======================
                                     USUARIO
                                     ====================== -->

                                <td class="audit-user">

                                    @if (
                                        auditoria.Usuario !=
                                        null
                                    )
                                    {
                                        <strong>

                                            @(
                                                auditoria
                                                    .Usuario
                                                    .Username
                                            )

                                        </strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            No identificado

                                        </span>
                                    }

                                </td>


                                <!-- ======================
                                     ACCIÓN
                                     ====================== -->

                                <td class="audit-action">

                                    @(
                                        auditoria.Accion
                                            .Replace(
                                                "_",
                                                " "
                                            )
                                    )

                                </td>


                                <!-- ======================
                                     IP
                                     ====================== -->

                                <td class="audit-ip">

                                    @(
                                        auditoria.DireccionIp
                                        ?? "-"
                                    )

                                </td>


                                <!-- ======================
                                     RESULTADO
                                     ====================== -->

                                <td class="audit-result">

                                    @if (
                                        auditoria.Resultado ==
                                        "EXITOSO"
                                    )
                                    {
                                        <span class="badge
                                                     rounded-pill
                                                     bg-success">

                                            ✓ EXITOSO

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge
                                                     rounded-pill
                                                     bg-danger">

                                            ✕ FALLIDO

                                        </span>
                                    }

                                </td>


                                <!-- ======================
                                     DETALLE
                                     ====================== -->

                                <td class="audit-detail">

                                    <div class="audit-operation">


                                        @if (
                                            !string.IsNullOrWhiteSpace(
                                                resumenOperacion
                                            )
                                        )
                                        {
                                            <div class="audit-operation-title">

                                                @resumenOperacion

                                            </div>
                                        }


                                        @if (
                                            datosOperacion.Any()
                                        )
                                        {
                                            <div class="audit-data-grid">

                                                @foreach (
                                                    var dato
                                                    in datosOperacion
                                                )
                                                {
                                                    <div class="audit-data-item">

                                                        <span class="audit-data-label">

                                                            @dato.Campo

                                                        </span>

                                                        <span class="audit-data-value">

                                                            @dato.Valor

                                                        </span>

                                                    </div>
                                                }

                                            </div>
                                        }


                                        @if (cambios.Any())
                                        {
                                            <div class="audit-changes-title">

                                                Cambios realizados

                                            </div>


                                            @foreach (
                                                string cambio
                                                in cambios
                                            )
                                            {
                                                int separadorCampo =
                                                    cambio
                                                        .IndexOf(
                                                            ':'
                                                        );

                                                string campo =
                                                    separadorCampo >= 0
                                                        ? cambio[
                                                            ..separadorCampo
                                                          ].Trim()
                                                        : "Cambio";

                                                string detalle =
                                                    separadorCampo >= 0
                                                        ? cambio[
                                                            (separadorCampo + 1)..
                                                          ].Trim()
                                                        : cambio.Trim();

                                                string[] valores =
                                                    detalle.Split(
                                                        " → ",
                                                        2,
                                                        StringSplitOptions
                                                            .None
                                                    );


                                                <div class="audit-change">

                                                    <div class="audit-change-field">

                                                        @campo

                                                    </div>


                                                    @if (
                                                        valores.Length ==
                                                        2
                                                    )
                                                    {
                                                        <div class="d-flex
                                                                    flex-wrap
                                                                    align-items-center">

                                                            <span class="audit-value
                                                                         audit-value-before">

                                                                <strong>

                                                                    Antes:

                                                                </strong>

                                                                &nbsp;

                                                                @valores[0]

                                                            </span>


                                                            <span class="audit-arrow">

                                                                →

                                                            </span>


                                                            <span class="audit-value
                                                                         audit-value-after">

                                                                <strong>

                                                                    Después:

                                                                </strong>

                                                                &nbsp;

                                                                @valores[1]

                                                            </span>

                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="small">

                                                            @detalle

                                                        </span>
                                                    }

                                                </div>
                                            }
                                        }


                                        @if (
                                            string.IsNullOrWhiteSpace(
                                                resumenOperacion
                                            ) &&
                                            !datosOperacion.Any() &&
                                            !cambios.Any()
                                        )
                                        {
                                            <span class="text-muted">

                                                Sin detalle

                                            </span>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    <div class="alert
                alert-light
                border
                mt-3">

        <small class="text-muted">

            Se muestran como máximo
            los 500 registros más recientes
            que coincidan con los filtros
            seleccionados.

        </small>

    </div>

</div>
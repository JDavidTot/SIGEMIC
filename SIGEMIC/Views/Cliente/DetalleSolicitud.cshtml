@model SIGEMIC.Models.SolicitudPago

@{
    ViewData["Title"] = "Detalle de solicitud";
}


<div class="container py-4">

    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->

    <div class="d-flex justify-content-between
                align-items-center
                flex-wrap
                gap-3
                mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                Solicitud #@Model.IdSolicitud

            </h2>

            <p class="text-muted mb-0">

                Enviada el
                @(Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm"))

            </p>

        </div>


        <a asp-controller="Cliente"
           asp-action="MisSolicitudes"
           class="btn btn-outline-secondary">

            Regresar

        </a>

    </div>


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">

            @TempData["Error"]

        </div>
    }


    <div class="row g-4">


        <!-- =================================================
             INFORMACIÓN
             ================================================= -->

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Información de la solicitud
                    </h5>

                </div>


                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <small class="text-muted">
                                Crédito
                            </small>

                            <div class="fw-semibold">

                                @Model.Credito.CodigoCredito

                            </div>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted">
                                Tipo de operación
                            </small>

                            <div class="fw-semibold">

                                @if (Model.TipoOperacion == "PAGO_CUOTA")
                                {
                                    <span>
                                        Pago de cuota
                                    </span>
                                }

                                @if (Model.TipoOperacion == "ABONO_EXTRAORDINARIO")
                                {
                                    <span>
                                        Abono extraordinario a capital
                                    </span>
                                }

                            </div>

                        </div>


                        @if (Model.Cuota != null)
                        {
                            <div class="col-md-6">

                                <small class="text-muted">
                                    Cuota
                                </small>

                                <div class="fw-semibold">

                                    #@Model.Cuota.NumeroCuota

                                </div>

                            </div>
                        }


                        <div class="col-md-6">

                            <small class="text-muted">
                                Monto reportado
                            </small>

                            <div class="fs-4 fw-bold text-primary">

                                Q @(Model.Monto.ToString("N2"))

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 DATOS BANCARIOS
                 ================================================= -->

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Datos del depósito
                    </h5>

                </div>


                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <small class="text-muted">
                                Banco
                            </small>

                            <div class="fw-semibold">

                                @Model.Banco.Nombre

                            </div>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted">
                                Cuenta
                            </small>

                            <div class="fw-semibold">

                                @Model.Banco.NumeroCuenta

                            </div>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted">
                                Número de boleta
                            </small>

                            <div class="fw-semibold">

                                @Model.NumeroBoleta

                            </div>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted">
                                Beneficiario
                            </small>

                            <div class="fw-semibold">

                                @Model.Banco.Beneficiario

                            </div>

                        </div>

                    </div>


                    <hr />


                    <a asp-controller="Cliente"
                       asp-action="VerComprobanteSolicitud"
                       asp-route-id="@Model.IdSolicitud"
                       target="_blank"
                       class="btn btn-outline-primary">

                        Ver comprobante enviado

                    </a>

                </div>

            </div>


            <!-- =================================================
                 PAGO GENERADO
                 ================================================= -->

            @if (Model.Estado == "APROBADA" &&
                 Model.Pago != null)
            {
                <div class="card border-success shadow-sm">

                    <div class="card-header bg-white">

                        <h5 class="text-success mb-0">
                            Pago aplicado
                        </h5>

                    </div>


                    <div class="card-body">

                        <div class="row g-3">

                            <div class="col-md-6">

                                <small class="text-muted">
                                    Recibo
                                </small>

                                <div class="fw-bold fs-5 text-success">

                                    @Model.Pago.NumeroRecibo

                                </div>

                            </div>


                            <div class="col-md-6">

                                <small class="text-muted">
                                    Monto aplicado
                                </small>

                                <div class="fw-semibold">

                                    Q @(Model.Pago.MontoTotal.ToString("N2"))

                                </div>

                            </div>


                            <div class="col-md-6">

                                <small class="text-muted">
                                    Capital aplicado
                                </small>

                                <div>

                                    Q @(Model.Pago.CapitalAplicado.ToString("N2"))

                                </div>

                            </div>


                            <div class="col-md-6">

                                <small class="text-muted">
                                    Interés aplicado
                                </small>

                                <div>

                                    Q @(Model.Pago.InteresAplicado.ToString("N2"))

                                </div>

                            </div>


                            <div class="col-md-6">

                                <small class="text-muted">
                                    Fecha de aplicación
                                </small>

                                <div>

                                    @(Model.Pago.FechaPago.ToString("dd/MM/yyyy HH:mm"))

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>


        <!-- =================================================
             ESTADO
             ================================================= -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Estado
                    </h5>

                </div>


                <div class="card-body">


                    @if (Model.Estado == "PENDIENTE")
                    {
                        <span class="badge bg-warning text-dark fs-6">

                            PENDIENTE

                        </span>


                        <div class="alert alert-warning mt-3 mb-0">

                            Tu comprobante está pendiente
                            de revisión.

                            <br /><br />

                            El pago todavía no ha sido aplicado
                            a tu crédito.

                        </div>
                    }


                    @if (Model.Estado == "APROBADA")
                    {
                        <span class="badge bg-success fs-6">

                            APROBADA

                        </span>


                        <div class="alert alert-success mt-3">

                            Tu solicitud fue aprobada y el pago
                            ya fue aplicado a tu crédito.

                        </div>


                        @if (Model.FechaRevision.HasValue)
                        {
                            <small class="text-muted">
                                Fecha de aprobación
                            </small>

                            <div>

                                @(Model.FechaRevision.Value.ToString("dd/MM/yyyy HH:mm"))

                            </div>
                        }
                    }


                    @if (Model.Estado == "RECHAZADA")
                    {
                        <span class="badge bg-danger fs-6">

                            RECHAZADA

                        </span>


                        <div class="alert alert-danger mt-3">

                            <strong>
                                Motivo:
                            </strong>

                            <br />

                            @Model.MotivoRechazo

                        </div>


                        @if (Model.FechaRevision.HasValue)
                        {
                            <small class="text-muted">
                                Fecha de revisión
                            </small>

                            <div>

                                @(Model.FechaRevision.Value.ToString("dd/MM/yyyy HH:mm"))

                            </div>
                        }
                    }

                </div>

            </div>

        </div>

    </div>

</div>
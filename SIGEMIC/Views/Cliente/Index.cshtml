@{
    ViewData["Title"] = "Mi cuenta";

    bool tieneCredito =
        ViewBag.TieneCredito ?? false;

    string codigoCliente =
        ViewBag.CodigoCliente ?? "";

    string? codigoCredito =
        ViewBag.CodigoCredito;

    decimal montoOriginal =
        ViewBag.MontoOriginal ?? 0m;

    decimal saldoCapital =
        ViewBag.SaldoCapital ?? 0m;

    decimal cuotaOriginal =
        ViewBag.CuotaOriginal ?? 0m;

    string estadoCredito =
        ViewBag.EstadoCredito ?? "SIN CRÉDITO";

    int cuotasPendientes =
        ViewBag.CuotasPendientes ?? 0;

    decimal totalPagado =
        ViewBag.TotalPagado ?? 0m;
}

<div class="container mt-4">

    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->

    <div class="mb-4">

        <h2>
            Mi cuenta
        </h2>

        <p class="text-muted mb-2">
            Bienvenido, @User.Identity?.Name
        </p>

        <p class="mb-0">
            Código de cliente:
            <strong>
                @codigoCliente
            </strong>
        </p>

    </div>


    <!-- =====================================================
         MENSAJES
         ===================================================== -->

    @if (TempData["MensajeInfo"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show"
             role="alert">

            @TempData["MensajeInfo"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- =====================================================
         RESUMEN DEL CRÉDITO
         ===================================================== -->

    <div class="row g-3 mb-3">

        <!-- CRÉDITO -->
        <div class="col-md-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Crédito
                    </small>

                    <h5 class="mb-0">

                        @if (tieneCredito)
                        {
                            @codigoCredito
                        }
                        else
                        {
                            <span>
                                Sin crédito
                            </span>
                        }

                    </h5>

                </div>

            </div>

        </div>


        <!-- MONTO ORIGINAL -->
        <div class="col-md-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Monto original
                    </small>

                    <h4 class="mb-0">
                        Q @montoOriginal.ToString("N2")
                    </h4>

                </div>

            </div>

        </div>


        <!-- SALDO -->
        <div class="col-md-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Saldo pendiente
                    </small>

                    <h4 class="mb-0">
                        Q @saldoCapital.ToString("N2")
                    </h4>

                </div>

            </div>

        </div>


        <!-- CUOTA -->
        <div class="col-md-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Cuota mensual
                    </small>

                    <h4 class="mb-0">
                        Q @cuotaOriginal.ToString("N2")
                    </h4>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         ESTADO Y PAGOS
         ===================================================== -->

    <div class="row g-3 mb-4">

        <!-- ESTADO -->
        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Estado del crédito
                    </small>

                    <div class="mt-1">

                        @if (estadoCredito == "ACTIVO")
                        {
                            <span class="badge bg-success fs-6">
                                ACTIVO
                            </span>
                        }
                        else if (estadoCredito == "ATRASADO")
                        {
                            <span class="badge bg-danger fs-6">
                                ATRASADO
                            </span>
                        }
                        else if (estadoCredito == "CANCELADO")
                        {
                            <span class="badge bg-secondary fs-6">
                                CANCELADO
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">
                                @estadoCredito
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- CUOTAS PENDIENTES -->
        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Cuotas pendientes
                    </small>

                    <h4 class="mb-0">
                        @cuotasPendientes
                    </h4>

                </div>

            </div>

        </div>


        <!-- TOTAL PAGADO -->
        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Total pagado
                    </small>

                    <h4 class="mb-0">
                        Q @totalPagado.ToString("N2")
                    </h4>

                </div>

            </div>

        </div>

    </div>


    <hr />


    <!-- =====================================================
         CONSULTAS
         ===================================================== -->

    <div class="mb-3">

        <h4>
            Consultas
        </h4>

    </div>


    <div class="row g-3">

        <!-- =================================================
             MI CRÉDITO
             ================================================= -->

        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h5>
                        Mi crédito
                    </h5>

                    <p class="text-muted">
                        Consultar información de mi crédito.
                    </p>

                    @if (tieneCredito)
                    {
                        <a asp-controller="Cliente"
                           asp-action="Credito"
                           class="btn btn-primary">

                            Ver crédito

                        </a>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-secondary"
                                disabled>

                            Sin crédito

                        </button>
                    }

                </div>

            </div>

        </div>


        <!-- =================================================
             MIS CUOTAS
             ================================================= -->

        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h5>
                        Mis cuotas
                    </h5>

                    <p class="text-muted">
                        Consultar calendario y estado de cuotas.
                    </p>

                    @if (tieneCredito)
                    {
                        <a asp-controller="Cliente"
                           asp-action="Cuotas"
                           class="btn btn-outline-primary">

                            Ver cuotas

                        </a>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-secondary"
                                disabled>

                            Sin cuotas

                        </button>
                    }

                </div>

            </div>

        </div>


        <!-- =================================================
             MIS PAGOS
             ================================================= -->

        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h5>
                        Mis pagos
                    </h5>

                    <p class="text-muted">
                        Consultar historial de pagos realizados.
                    </p>

                    <a asp-controller="Cliente"
                       asp-action="EstadoCuenta"
                       class="btn btn-outline-primary">

                        Ver estado de cuenta

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
@model IEnumerable<SIGEMIC.Models.SolicitudPago>

@{
    ViewData["Title"] = "Mis solicitudes";

    var pendientes =
        Model.Count(s =>
            s.Estado == "PENDIENTE"
        );

    var aprobadas =
        Model.Count(s =>
            s.Estado == "APROBADA"
        );

    var rechazadas =
        Model.Count(s =>
            s.Estado == "RECHAZADA"
        );
}


<div class="container py-4">

    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->

    <div class="d-flex justify-content-between
                align-items-center
                flex-wrap
                gap-3
                mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Mis solicitudes
            </h2>

            <p class="text-muted mb-0">

                Consulta el estado de los pagos
                y abonos que has enviado.

            </p>

        </div>


        <a asp-controller="Cliente"
           asp-action="SolicitarPago"
           class="btn btn-primary">

            Nueva solicitud

        </a>

    </div>


    <!-- =====================================================
         RESUMEN
         ===================================================== -->

    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Pendientes
                    </small>

                    <div class="fs-3 fw-bold text-warning">

                        @pendientes

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Aprobadas
                    </small>

                    <div class="fs-3 fw-bold text-success">

                        @aprobadas

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Rechazadas
                    </small>

                    <div class="fs-3 fw-bold text-danger">

                        @rechazadas

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         TABLA
         ===================================================== -->

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <h5>
                        No tienes solicitudes
                    </h5>

                    <p class="text-muted">

                        Cuando envíes un pago o un abono,
                        aparecerá aquí.

                    </p>


                    <a asp-controller="Cliente"
                       asp-action="SolicitarPago"
                       class="btn btn-primary">

                        Solicitar pago

                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>
                                    Solicitud
                                </th>

                                <th>
                                    Fecha
                                </th>

                                <th>
                                    Crédito
                                </th>

                                <th>
                                    Tipo
                                </th>

                                <th>
                                    Monto
                                </th>

                                <th>
                                    Banco
                                </th>

                                <th>
                                    Estado
                                </th>

                                <th>
                                    Recibo
                                </th>

                                <th class="text-end">
                                    Acción
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="fw-semibold">

                                        #@item.IdSolicitud

                                    </td>


                                    <td>

                                        @(item.FechaSolicitud.ToString("dd/MM/yyyy HH:mm"))

                                    </td>


                                    <td>

                                        @item.Credito.CodigoCredito

                                    </td>


                                    <td>

                                        @if (item.TipoOperacion == "PAGO_CUOTA")
                                        {
                                            <span>
                                                Pago de cuota
                                            </span>

                                            @if (item.Cuota != null)
                                            {
                                                <br />

                                                <small class="text-muted">

                                                    Cuota
                                                    #@item.Cuota.NumeroCuota

                                                </small>
                                            }
                                        }


                                        @if (item.TipoOperacion == "ABONO_EXTRAORDINARIO")
                                        {
                                            <span>
                                                Abono a capital
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <strong>

                                            Q @(item.Monto.ToString("N2"))

                                        </strong>

                                    </td>


                                    <td>

                                        @item.Banco.Nombre

                                    </td>


                                    <td>

                                        @if (item.Estado == "PENDIENTE")
                                        {
                                            <span class="badge bg-warning text-dark">

                                                PENDIENTE

                                            </span>
                                        }


                                        @if (item.Estado == "APROBADA")
                                        {
                                            <span class="badge bg-success">

                                                APROBADA

                                            </span>
                                        }


                                        @if (item.Estado == "RECHAZADA")
                                        {
                                            <span class="badge bg-danger">

                                                RECHAZADA

                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @if (item.Pago != null)
                                        {
                                            <span class="fw-semibold text-success">

                                                @item.Pago.NumeroRecibo

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">

                                                -

                                            </span>
                                        }

                                    </td>


                                    <td class="text-end">

                                        <a asp-controller="Cliente"
                                           asp-action="DetalleSolicitud"
                                           asp-route-id="@item.IdSolicitud"
                                           class="btn btn-outline-primary btn-sm">

                                            Ver

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    <div class="mt-3">

        <a asp-controller="Cliente"
           asp-action="Index"
           class="btn btn-outline-secondary">

            Volver a mi cuenta

        </a>

    </div>

</div>
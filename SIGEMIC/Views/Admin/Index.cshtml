@{
    ViewData["Title"] = "Dashboard Administrador";

    int totalClientes =
        ViewBag.TotalClientes ?? 0;

    int creditosActivos =
        ViewBag.CreditosActivos ?? 0;

    int creditosAtrasados =
        ViewBag.CreditosAtrasados ?? 0;

    decimal totalPrestado =
        ViewBag.TotalPrestado ?? 0m;

    decimal saldoPendiente =
        ViewBag.SaldoPendiente ?? 0m;

    decimal totalPagos =
        ViewBag.TotalPagos ?? 0m;

    int solicitudesPendientes =
        ViewBag.SolicitudesPendientes ?? 0;
}


<div class="container mt-4">


    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->

    <div class="mb-4">

        <h2>
            Dashboard Administrador
        </h2>

        <p class="text-muted mb-0">

            Resumen general y administración de SIGEMIC.

        </p>

    </div>


    <!-- =====================================================
         INDICADORES PRINCIPALES
         ===================================================== -->

    <div class="row g-3 mb-4">


        <!-- CLIENTES -->

        <div class="col-md-4 col-lg-2">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Clientes
                    </small>

                    <h3 class="mb-0">

                        @totalClientes

                    </h3>

                </div>

            </div>

        </div>


        <!-- CRÉDITOS ACTIVOS -->

        <div class="col-md-4 col-lg-2">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Créditos activos
                    </small>

                    <h3 class="mb-0">

                        @creditosActivos

                    </h3>

                </div>

            </div>

        </div>


        <!-- CRÉDITOS ATRASADOS -->

        <div class="col-md-4 col-lg-2">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Créditos atrasados
                    </small>

                    <h3 class="mb-0">

                        @creditosAtrasados

                    </h3>

                </div>

            </div>

        </div>


        <!-- TOTAL PRESTADO -->

        <div class="col-md-4 col-lg-2">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Total prestado
                    </small>

                    <h5 class="mb-0">

                        Q @totalPrestado.ToString("N2")

                    </h5>

                </div>

            </div>

        </div>


        <!-- SALDO PENDIENTE -->

        <div class="col-md-4 col-lg-2">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Saldo pendiente
                    </small>

                    <h5 class="mb-0">

                        Q @saldoPendiente.ToString("N2")

                    </h5>

                </div>

            </div>

        </div>


        <!-- TOTAL RECIBIDO -->

        <div class="col-md-4 col-lg-2">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Total recibido
                    </small>

                    <h5 class="mb-0">

                        Q @totalPagos.ToString("N2")

                    </h5>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         SOLICITUDES PENDIENTES
         ===================================================== -->

    <div class="card shadow-sm border-warning mb-4">

        <div class="card-body">

            <div class="row align-items-center g-3">

                <div class="col-md-8">

                    <small class="text-muted">

                        Solicitudes de pago pendientes

                    </small>


                    <div class="d-flex align-items-center gap-3 mt-1">

                        <h2 class="mb-0">

                            @solicitudesPendientes

                        </h2>


                        @if (solicitudesPendientes > 0)
                        {
                            <span class="badge bg-warning text-dark">

                                Requieren revisión

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">

                                Sin pendientes

                            </span>
                        }

                    </div>


                    <p class="text-muted mb-0 mt-2">

                        Solicitudes enviadas por los clientes
                        que todavía no han sido aprobadas o rechazadas.

                    </p>

                </div>


                <div class="col-md-4 text-md-end">

                    <a asp-controller="SolicitudesPago"
                       asp-action="Index"
                       asp-route-estado="PENDIENTE"
                       class="btn btn-warning">

                        Revisar solicitudes

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         MÓDULOS ADMINISTRATIVOS
         ===================================================== -->

    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <h5 class="mb-0">

                Módulos administrativos

            </h5>

        </div>


        <div class="card-body">

            <div class="row g-3">


                <!-- CLIENTES -->

                <div class="col-md-6 col-lg-4">

                    <div class="border rounded p-3 h-100">

                        <h5>
                            Clientes
                        </h5>

                        <p class="text-muted">

                            Crear, consultar, editar,
                            activar o inactivar clientes.

                        </p>

                        <a asp-controller="Clientes"
                           asp-action="Index"
                           class="btn btn-outline-primary">

                            Administrar clientes

                        </a>

                    </div>

                </div>


                <!-- CRÉDITOS -->

                <div class="col-md-6 col-lg-4">

                    <div class="border rounded p-3 h-100">

                        <h5>
                            Créditos
                        </h5>

                        <p class="text-muted">

                            Otorgar créditos y consultar
                            tablas de amortización.

                        </p>

                        <a asp-controller="Creditos"
                           asp-action="Index"
                           class="btn btn-outline-primary">

                            Administrar créditos

                        </a>

                    </div>

                </div>


                <!-- PLANES -->

                <div class="col-md-6 col-lg-4">

                    <div class="border rounded p-3 h-100">

                        <h5>
                            Planes de crédito
                        </h5>

                        <p class="text-muted">

                            Administrar tasas, tipos de tasa
                            y planes disponibles.

                        </p>

                        <a asp-controller="PlanesCredito"
                           asp-action="Index"
                           class="btn btn-outline-primary">

                            Administrar planes

                        </a>

                    </div>

                </div>


                <!-- REGISTRAR PAGOS -->

                <div class="col-md-6 col-lg-4">

                    <div class="border rounded p-3 h-100">

                        <h5>
                            Registrar pagos
                        </h5>

                        <p class="text-muted">

                            Registrar cuotas, pagos parciales
                            y abonos a capital.

                        </p>

                        <a asp-controller="Pagos"
                           asp-action="Index"
                           class="btn btn-outline-primary">

                            Registrar pago

                        </a>

                    </div>

                </div>


                <!-- SOLICITUDES DE PAGO -->

                <div class="col-md-6 col-lg-4">

                    <div class="border rounded p-3 h-100">

                        <div class="d-flex justify-content-between
                                    align-items-start
                                    gap-2">

                            <h5>
                                Solicitudes de pago
                            </h5>


                            @if (solicitudesPendientes > 0)
                            {
                                <span class="badge bg-warning text-dark">

                                    @solicitudesPendientes

                                </span>
                            }

                        </div>


                        <p class="text-muted">

                            Revisar comprobantes enviados por
                            clientes y aprobar o rechazar solicitudes.

                        </p>


                        <a asp-controller="SolicitudesPago"
                           asp-action="Index"
                           asp-route-estado="PENDIENTE"
                           class="btn btn-outline-warning">

                            Revisar solicitudes

                        </a>

                    </div>

                </div>


                <!-- HISTORIAL -->

                <div class="col-md-6 col-lg-4">

                    <div class="border rounded p-3 h-100">

                        <h5>
                            Historial de pagos
                        </h5>

                        <p class="text-muted">

                            Consultar recibos, pagos
                            y abonos realizados.

                        </p>

                        <a asp-controller="Pagos"
                           asp-action="Historial"
                           class="btn btn-outline-primary">

                            Ver historial

                        </a>

                    </div>

                </div>


                <!-- AUDITORÍA -->

                <div class="col-md-6 col-lg-4">

                    <div class="border rounded p-3 h-100">

                        <h5>
                            Auditoría
                        </h5>

                        <p class="text-muted">

                            Registro de acciones y eventos
                            importantes del sistema.

                        </p>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                disabled>

                            Próximamente

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
@model IEnumerable<SIGEMIC.Models.Cliente>
@using System.Security.Claims
@inject SIGEMIC.Services.PermisoService PermisoService

@{
    ViewData["Title"] = "Clientes";

    bool puedeCrear = User.IsInRole("ADMINISTRADOR");
    bool puedeEditar = User.IsInRole("ADMINISTRADOR");
    bool puedeCambiarEstado = User.IsInRole("ADMINISTRADOR");

    if (User.IsInRole("CAJERO"))
    {
        var idTexto = User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (uint.TryParse(idTexto, out uint idUsuario))
        {
            var permisos = (await PermisoService.ObtenerPermisosAsync(idUsuario))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            puedeCrear = permisos.Contains("CLIENTES_CREAR");
            puedeEditar = permisos.Contains("CLIENTES_EDITAR");
            puedeCambiarEstado = permisos.Contains("CLIENTES_CAMBIAR_ESTADO");
        }
    }
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Clientes</h2>
            <p class="text-muted mb-0">Administración de clientes registrados en SIGEMIC.</p>
        </div>

        @if (puedeCrear)
        {
            <a asp-action="Create" class="btn btn-primary">
                + Nuevo cliente
            </a>
        }
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success">
            @TempData["MensajeExito"]
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["MensajeError"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Código</th>
                            <th>Cliente</th>
                            <th>Usuario</th>
                            <th>Ingreso mensual</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cliente in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@cliente.CodigoCliente</strong>
                                </td>

                                <td>
                                    @cliente.Usuario.Nombres @cliente.Usuario.Apellidos
                                </td>

                                <td>
                                    @cliente.Usuario.Username
                                </td>

                                <td>
                                    @if (cliente.IngresoMensual.HasValue)
                                    {
                                        @($"Q {cliente.IngresoMensual.Value:N2}")
                                    }
                                    else
                                    {
                                        <span class="text-muted">No registrado</span>
                                    }
                                </td>

                                <td>
                                    @if (cliente.Estado == "ACTIVO")
                                    {
                                        <span class="badge bg-success">ACTIVO</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">INACTIVO</span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-action="Details"
                                       asp-route-id="@cliente.IdCliente"
                                       class="btn btn-outline-primary btn-sm">
                                        Ver
                                    </a>

                                    @if (puedeEditar)
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@cliente.IdCliente"
                                           class="btn btn-outline-secondary btn-sm">
                                            Editar
                                        </a>
                                    }

                                    @if (puedeCambiarEstado)
                                    {
                                        <form asp-action="CambiarEstado"
                                              asp-route-id="@cliente.IdCliente"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()

                                            @if (cliente.Estado == "ACTIVO")
                                            {
                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm"
                                                        onclick="return confirm('¿Deseas inactivar este cliente?');">
                                                    Inactivar
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-outline-success btn-sm"
                                                        onclick="return confirm('¿Deseas activar este cliente?');">
                                                    Activar
                                                </button>
                                            }
                                        </form>
                                    }
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    No hay clientes registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
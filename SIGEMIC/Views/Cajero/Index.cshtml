@{
    ViewData["Title"] = "Dashboard Cajero";

    var listaPermisos =
        ViewData["PermisosCajero"] as List<string>
        ?? new List<string>();

    var permisos =
        new HashSet<string>(
            listaPermisos,
            StringComparer.OrdinalIgnoreCase);

    bool clientesVer =
        permisos.Contains("CLIENTES_VER");

    bool clientesCrear =
        permisos.Contains("CLIENTES_CREAR");

    bool creditosVer =
        permisos.Contains("CREDITOS_VER");

    bool creditosCrear =
        permisos.Contains("CREDITOS_CREAR");

    bool pagosRegistrar =
        permisos.Contains("PAGOS_REGISTRAR");

    bool abonoCapital =
        permisos.Contains("PAGOS_ABONO_CAPITAL");

    bool pagosHistorial =
        permisos.Contains("PAGOS_HISTORIAL");

    bool solicitudesVer =
        permisos.Contains("SOLICITUDES_VER");

    bool solicitudesAprobar =
        permisos.Contains("SOLICITUDES_APROBAR");

    bool solicitudesRechazar =
        permisos.Contains("SOLICITUDES_RECHAZAR");

    int totalClientes =
        ViewBag.TotalClientes ?? 0;

    int creditosActivos =
        ViewBag.CreditosActivos ?? 0;

    int cuotasPendientes =
        ViewBag.CuotasPendientes ?? 0;

    decimal pagosHoy =
        ViewBag.PagosHoy ?? 0m;

    int solicitudesPendientes =
        ViewBag.SolicitudesPendientes ?? 0;

    bool tieneOperaciones =
        clientesVer ||
        clientesCrear ||
        creditosVer ||
        creditosCrear ||
        pagosRegistrar ||
        pagosHistorial ||
        solicitudesVer;
}

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="mb-1">
            Dashboard Cajero
        </h2>

        <p class="text-muted mb-0">
            Operaciones disponibles según los permisos asignados a tu usuario.
        </p>
    </div>

    @if (clientesVer ||
         creditosVer ||
         pagosRegistrar ||
         pagosHistorial)
    {
        <div class="row g-3 mb-4">

            @if (clientesVer)
            {
                <div class="col-md-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <small class="text-muted">
                                Clientes
                            </small>

                            <h3 class="mb-0">
                                @totalClientes
                            </h3>
                        </div>
                    </div>
                </div>
            }

            @if (creditosVer)
            {
                <div class="col-md-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <small class="text-muted">
                                Créditos activos
                            </small>

                            <h3 class="mb-0">
                                @creditosActivos
                            </h3>
                        </div>
                    </div>
                </div>
            }

            @if (pagosRegistrar)
            {
                <div class="col-md-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <small class="text-muted">
                                Cuotas pendientes
                            </small>

                            <h3 class="mb-0">
                                @cuotasPendientes
                            </h3>
                        </div>
                    </div>
                </div>
            }

            @if (pagosHistorial)
            {
                <div class="col-md-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <small class="text-muted">
                                Pagos de hoy
                            </small>

                            <h3 class="mb-0">
                                Q @pagosHoy.ToString("N2")
                            </h3>
                        </div>
                    </div>
                </div>
            }

        </div>
    }

    @if (solicitudesVer)
    {
        <div class="card shadow-sm border-warning mb-4">
            <div class="card-body">

                <div class="row align-items-center g-3">

                    <div class="col-md-8">

                        <small class="text-muted">
                            Solicitudes de pago pendientes
                        </small>

                        <div class="d-flex align-items-center gap-3 mt-1">

                            <h2 class="mb-0">
                                @solicitudesPendientes
                            </h2>

                            @if (solicitudesPendientes > 0)
                            {
                                <span class="badge bg-warning text-dark">
                                    Requieren revisión
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    Sin pendientes
                                </span>
                            }

                        </div>

                        <p class="text-muted mb-0 mt-2">
                            Comprobantes enviados por clientes
                            que todavía necesitan ser revisados.
                        </p>

                    </div>

                    <div class="col-md-4 text-md-end">

                        <a asp-controller="SolicitudesPago"
                           asp-action="Index"
                           asp-route-estado="PENDIENTE"
                           class="btn btn-warning">
                            Revisar solicitudes
                        </a>

                    </div>

                </div>

            </div>
        </div>
    }

    @if (tieneOperaciones)
    {
        <div class="card shadow-sm">

            <div class="card-header bg-white">
                <h5 class="mb-0">
                    Operaciones disponibles
                </h5>
            </div>

            <div class="card-body">

                <div class="row g-3">

                    @if (clientesVer || clientesCrear)
                    {
                        <div class="col-md-4">

                            <div class="border rounded p-3 h-100">

                                <h5>
                                    Clientes
                                </h5>

                                <p class="text-muted">
                                    Consulta o registra clientes según
                                    los permisos asignados.
                                </p>

                                <div class="d-flex flex-wrap gap-2">

                                    @if (clientesVer)
                                    {
                                        <a asp-controller="Clientes"
                                           asp-action="Index"
                                           class="btn btn-outline-primary">
                                            Ver clientes
                                        </a>
                                    }

                                    @if (clientesCrear)
                                    {
                                        <a asp-controller="Clientes"
                                           asp-action="Create"
                                           class="btn btn-outline-success">
                                            Nuevo cliente
                                        </a>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                    @if (creditosVer || creditosCrear)
                    {
                        <div class="col-md-4">

                            <div class="border rounded p-3 h-100">

                                <h5>
                                    Créditos
                                </h5>

                                <p class="text-muted">
                                    Consulta créditos o registra
                                    nuevos microcréditos.
                                </p>

                                <div class="d-flex flex-wrap gap-2">

                                    @if (creditosVer)
                                    {
                                        <a asp-controller="Creditos"
                                           asp-action="Index"
                                           class="btn btn-outline-primary">
                                            Ver créditos
                                        </a>
                                    }

                                    @if (creditosCrear)
                                    {
                                        <a asp-controller="Creditos"
                                           asp-action="Create"
                                           class="btn btn-outline-success">
                                            Nuevo crédito
                                        </a>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                    @if (pagosRegistrar)
                    {
                        <div class="col-md-4">

                            <div class="border rounded p-3 h-100">

                                <div class="d-flex justify-content-between
                                            align-items-start gap-2">

                                    <h5>
                                        Registrar pago
                                    </h5>

                                    @if (abonoCapital)
                                    {
                                        <span class="badge bg-success">
                                            Abono a capital
                                        </span>
                                    }

                                </div>

                                <p class="text-muted">
                                    Cobrar cuotas
                                    @if (abonoCapital)
                                    {
                                        <span>
                                            y realizar abonos extraordinarios
                                            a capital.
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            de los créditos activos.
                                        </span>
                                    }
                                </p>

                                <a asp-controller="Pagos"
                                   asp-action="Index"
                                   class="btn btn-outline-primary">
                                    Registrar pago
                                </a>

                            </div>

                        </div>
                    }

                    @if (solicitudesVer)
                    {
                        <div class="col-md-4">

                            <div class="border rounded p-3 h-100">

                                <div class="d-flex justify-content-between
                                            align-items-start gap-2">

                                    <h5>
                                        Solicitudes de pago
                                    </h5>

                                    @if (solicitudesPendientes > 0)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @solicitudesPendientes
                                        </span>
                                    }

                                </div>

                                <p class="text-muted mb-2">
                                    Revisar comprobantes enviados
                                    por los clientes.
                                </p>

                                <div class="mb-3">

                                    @if (solicitudesAprobar)
                                    {
                                        <span class="badge bg-success me-1">
                                            Puede aprobar
                                        </span>
                                    }

                                    @if (solicitudesRechazar)
                                    {
                                        <span class="badge bg-danger">
                                            Puede rechazar
                                        </span>
                                    }

                                    @if (!solicitudesAprobar &&
                                         !solicitudesRechazar)
                                    {
                                        <span class="badge bg-secondary">
                                            Solo consulta
                                        </span>
                                    }

                                </div>

                                <a asp-controller="SolicitudesPago"
                                   asp-action="Index"
                                   asp-route-estado="PENDIENTE"
                                   class="btn btn-outline-warning">
                                    Revisar solicitudes
                                </a>

                            </div>

                        </div>
                    }

                    @if (pagosHistorial)
                    {
                        <div class="col-md-4">

                            <div class="border rounded p-3 h-100">

                                <h5>
                                    Historial de pagos
                                </h5>

                                <p class="text-muted">
                                    Consultar recibos, pagos
                                    y abonos registrados.
                                </p>

                                <a asp-controller="Pagos"
                                   asp-action="Historial"
                                   class="btn btn-outline-primary">
                                    Ver historial
                                </a>

                            </div>

                        </div>
                    }

                </div>

            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">

            <h5 class="alert-heading">
                Sin permisos asignados
            </h5>

            <p class="mb-0">
                Tu usuario de cajero está activo, pero actualmente
                no tiene funciones habilitadas. Solicita a un
                administrador que revise tus permisos.
            </p>

        </div>
    }

</div>
@{
    ViewData["Title"] = "Dashboard Cajero";

    int totalClientes =
        ViewBag.TotalClientes ?? 0;

    int creditosActivos =
        ViewBag.CreditosActivos ?? 0;

    int cuotasPendientes =
        ViewBag.CuotasPendientes ?? 0;

    decimal pagosHoy =
        ViewBag.PagosHoy ?? 0m;
}

<div class="container mt-4">

    <div class="mb-4">

        <h2>Dashboard Cajero</h2>

        <p class="text-muted mb-0">
            Operaciones principales de atención y cobro.
        </p>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Clientes
                    </small>

                    <h3 class="mb-0">
                        @totalClientes
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Créditos activos
                    </small>

                    <h3 class="mb-0">
                        @creditosActivos
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Cuotas pendientes
                    </small>

                    <h3 class="mb-0">
                        @cuotasPendientes
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Pagos de hoy
                    </small>

                    <h3 class="mb-0">
                        Q @pagosHoy.ToString("N2")
                    </h3>

                </div>

            </div>

        </div>

    </div>


    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                Operaciones
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-3">

                <!-- CLIENTES -->
                <div class="col-md-4">

                    <div class="border rounded p-3 h-100">

                        <h5>
                            Clientes
                        </h5>

                        <p class="text-muted">
                            Consultar y registrar clientes.
                        </p>

                        <a asp-controller="Clientes"
                           asp-action="Index"
                           class="btn btn-outline-primary">

                            Ver clientes

                        </a>

                    </div>

                </div>


                <!-- CRÉDITOS -->
                <div class="col-md-4">

                    <div class="border rounded p-3 h-100">

                        <h5>
                            Créditos
                        </h5>

                        <p class="text-muted">
                            Consultar créditos y tablas de amortización.
                        </p>

                        <a asp-controller="Creditos"
                           asp-action="Index"
                           class="btn btn-outline-primary">

                            Ver créditos

                        </a>

                    </div>

                </div>


                <!-- REGISTRAR PAGO -->
                <div class="col-md-4">

                    <div class="border rounded p-3 h-100">

                        <h5>
                            Registrar pago
                        </h5>

                        <p class="text-muted">
                            Cobrar cuotas o registrar abonos a capital.
                        </p>

                        <a asp-controller="Pagos"
                           asp-action="Index"
                           class="btn btn-outline-primary">

                            Registrar pago

                        </a>

                    </div>

                </div>


                <!-- HISTORIAL -->
                <div class="col-md-4">

                    <div class="border rounded p-3 h-100">

                        <h5>
                            Historial de pagos
                        </h5>

                        <p class="text-muted">
                            Consultar recibos, pagos y abonos registrados.
                        </p>

                        <a asp-controller="Pagos"
                           asp-action="Historial"
                           class="btn btn-outline-primary">

                            Ver historial

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
@model IEnumerable<SIGEMIC.Models.Credito>
@using System.Security.Claims
@inject SIGEMIC.Services.PermisoService PermisoService

@{
    ViewData["Title"] = "Créditos";

    bool puedeCrear = User.IsInRole("ADMINISTRADOR");
    bool puedeVerDetalle = User.IsInRole("ADMINISTRADOR");

    if (User.IsInRole("CAJERO"))
    {
        var idTexto = User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (uint.TryParse(idTexto, out uint idUsuario))
        {
            var permisos = (await PermisoService.ObtenerPermisosAsync(idUsuario))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            puedeCrear = permisos.Contains("CREDITOS_CREAR");
            puedeVerDetalle = permisos.Contains("CREDITOS_DETALLE");
        }
    }
}

<div class="container mt-4">

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["MensajeExito"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["MensajeError"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Créditos</h2>
            <p class="text-muted mb-0">
                Administración de microcréditos otorgados.
            </p>
        </div>

        @if (puedeCrear)
        {
            <a asp-controller="Creditos"
               asp-action="Create"
               class="btn btn-primary">
                Nuevo crédito
            </a>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Cliente</th>
                                <th>Plan</th>
                                <th>Monto</th>
                                <th>Plazo</th>
                                <th>Cuota</th>
                                <th>Saldo</th>
                                <th>Estado</th>

                                @if (puedeVerDetalle)
                                {
                                    <th class="text-end">Acciones</th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var credito in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>
                                            @credito.CodigoCredito
                                        </strong>
                                    </td>

                                    <td>
                                        @credito.Cliente.Usuario.Nombres
                                        @credito.Cliente.Usuario.Apellidos

                                        <div class="small text-muted">
                                            @credito.Cliente.CodigoCliente
                                        </div>
                                    </td>

                                    <td>
                                        @credito.PlanCredito.Nombre
                                    </td>

                                    <td>
                                        Q @credito.MontoOriginal.ToString("N2")
                                    </td>

                                    <td>
                                        @credito.PlazoMeses meses
                                    </td>

                                    <td>
                                        Q @credito.CuotaOriginal.ToString("N2")
                                    </td>

                                    <td>
                                        <strong>
                                            Q @credito.SaldoCapital.ToString("N2")
                                        </strong>
                                    </td>

                                    <td>
                                        @if (credito.Estado == "ACTIVO")
                                        {
                                            <span class="badge bg-success">
                                                ACTIVO
                                            </span>
                                        }
                                        else if (credito.Estado == "ATRASADO")
                                        {
                                            <span class="badge bg-danger">
                                                ATRASADO
                                            </span>
                                        }
                                        else if (credito.Estado == "CANCELADO")
                                        {
                                            <span class="badge bg-secondary">
                                                CANCELADO
                                            </span>
                                        }
                                        else if (credito.Estado == "PENDIENTE")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                PENDIENTE
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @credito.Estado
                                            </span>
                                        }
                                    </td>

                                    @if (puedeVerDetalle)
                                    {
                                        <td class="text-end">
                                            <a asp-controller="Creditos"
                                               asp-action="Details"
                                               asp-route-id="@credito.IdCredito"
                                               class="btn btn-outline-primary btn-sm">
                                                Ver
                                            </a>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    No existen créditos registrados.
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        @if (User.IsInRole("ADMINISTRADOR"))
        {
            <a asp-controller="Admin"
               asp-action="Index"
               class="btn btn-secondary">
                Volver al dashboard
            </a>
        }
        else if (User.IsInRole("CAJERO"))
        {
            <a asp-controller="Cajero"
               asp-action="Index"
               class="btn btn-secondary">
                Volver al dashboard
            </a>
        }
    </div>
</div>
@model SIGEMIC.Models.Credito
@using System.Security.Claims
@inject SIGEMIC.Services.PermisoService PermisoService

@{
    ViewData["Title"] = "Detalle del crédito";

    var totalPagado = Model.Cuotas
        .Sum(c => c.CapitalPagado + c.InteresPagado + c.MoraPagada);

    var cuotasPagadas = Model.Cuotas
        .Count(c => c.Estado == "PAGADA");

    var cuotasPendientes = Model.Cuotas
        .Count(c => c.Estado != "PAGADA");

    bool puedeVerListado = User.IsInRole("ADMINISTRADOR");

    if (User.IsInRole("CAJERO"))
    {
        var idTexto = User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (uint.TryParse(idTexto, out uint idUsuario))
        {
            puedeVerListado = await PermisoService.TienePermisoAsync(
                idUsuario,
                "CREDITOS_VER"
            );
        }
    }
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Detalle del crédito</h2>

            <p class="text-muted mb-0">
                <strong>@Model.CodigoCredito</strong>
                -
                @Model.Cliente.Usuario.Nombres
                @Model.Cliente.Usuario.Apellidos
            </p>
        </div>

        @if (puedeVerListado)
        {
            <a asp-action="Index"
               class="btn btn-secondary">
                Volver
            </a>
        }
        else if (User.IsInRole("CAJERO"))
        {
            <a asp-controller="Cajero"
               asp-action="Index"
               class="btn btn-secondary">
                Volver al dashboard
            </a>
        }
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">
                        Monto original
                    </small>

                    <h4 class="mb-0">
                        Q @Model.MontoOriginal.ToString("N2")
                    </h4>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">
                        Saldo de capital
                    </small>

                    <h4 class="mb-0">
                        Q @Model.SaldoCapital.ToString("N2")
                    </h4>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">
                        Cuota original
                    </small>

                    <h4 class="mb-0">
                        Q @Model.CuotaOriginal.ToString("N2")
                    </h4>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">
                        Estado
                    </small>

                    <div class="mt-1">
                        @if (Model.Estado == "ACTIVO")
                        {
                            <span class="badge bg-success fs-6">
                                ACTIVO
                            </span>
                        }
                        else if (Model.Estado == "ATRASADO")
                        {
                            <span class="badge bg-danger fs-6">
                                ATRASADO
                            </span>
                        }
                        else if (Model.Estado == "CANCELADO")
                        {
                            <span class="badge bg-secondary fs-6">
                                CANCELADO
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark fs-6">
                                @Model.Estado
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">
                Información del crédito
            </h5>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-6">
                    <dl class="row mb-0">

                        <dt class="col-sm-5">
                            Cliente
                        </dt>

                        <dd class="col-sm-7">
                            @Model.Cliente.CodigoCliente -
                            @Model.Cliente.Usuario.Nombres
                            @Model.Cliente.Usuario.Apellidos
                        </dd>

                        <dt class="col-sm-5">
                            Plan
                        </dt>

                        <dd class="col-sm-7">
                            @Model.PlanCredito.Nombre
                        </dd>

                        <dt class="col-sm-5">
                            Tipo de tasa
                        </dt>

                        <dd class="col-sm-7">
                            @Model.TipoTasaAplicada
                        </dd>

                        <dt class="col-sm-5">
                            Tasa aplicada
                        </dt>

                        <dd class="col-sm-7">
                            @Model.PorcentajeInteresAplicado.ToString("N4") %
                        </dd>

                        <dt class="col-sm-5">
                            Plazo original
                        </dt>

                        <dd class="col-sm-7">
                            @Model.PlazoMeses meses
                        </dd>

                    </dl>
                </div>

                <div class="col-md-6">
                    <dl class="row mb-0">

                        <dt class="col-sm-6">
                            Fecha otorgamiento
                        </dt>

                        <dd class="col-sm-6">
                            @Model.FechaOtorgamiento.ToString("dd/MM/yyyy")
                        </dd>

                        <dt class="col-sm-6">
                            Fecha inicio
                        </dt>

                        <dd class="col-sm-6">
                            @Model.FechaInicio.ToString("dd/MM/yyyy")
                        </dd>

                        <dt class="col-sm-6">
                            Finalización estimada
                        </dt>

                        <dd class="col-sm-6">
                            @Model.FechaFinalizacionEstimada.ToString("dd/MM/yyyy")
                        </dd>

                        <dt class="col-sm-6">
                            Cuotas pagadas
                        </dt>

                        <dd class="col-sm-6">
                            @cuotasPagadas
                        </dd>

                        <dt class="col-sm-6">
                            Cuotas pendientes
                        </dt>

                        <dd class="col-sm-6">
                            @cuotasPendientes
                        </dd>

                    </dl>
                </div>

            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <small class="text-muted">
                        Total pagado en cuotas
                    </small>

                    <h4>
                        Q @totalPagado.ToString("N2")
                    </h4>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <small class="text-muted">
                        Cuotas pagadas
                    </small>

                    <h4>
                        @cuotasPagadas
                    </h4>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <small class="text-muted">
                        Cuotas pendientes
                    </small>

                    <h4>
                        @cuotasPendientes
                    </h4>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0">
                Tabla de amortización
            </h5>
        </div>

        <div class="card-body">

            @if (Model.Cuotas != null && Model.Cuotas.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>No.</th>
                                <th>Vencimiento</th>
                                <th>Capital</th>
                                <th>Interés</th>
                                <th>Cuota</th>
                                <th>Capital pagado</th>
                                <th>Interés pagado</th>
                                <th>Saldo cuota</th>
                                <th>Estado</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var cuota in Model.Cuotas.OrderBy(c => c.NumeroCuota))
                            {
                                <tr>
                                    <td>
                                        @cuota.NumeroCuota
                                    </td>

                                    <td>
                                        @cuota.FechaVencimiento.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        Q @cuota.CapitalProgramado.ToString("N2")
                                    </td>

                                    <td>
                                        Q @cuota.InteresProgramado.ToString("N2")
                                    </td>

                                    <td>
                                        <strong>
                                            Q @cuota.CuotaProgramada.ToString("N2")
                                        </strong>
                                    </td>

                                    <td>
                                        Q @cuota.CapitalPagado.ToString("N2")
                                    </td>

                                    <td>
                                        Q @cuota.InteresPagado.ToString("N2")
                                    </td>

                                    <td>
                                        Q @cuota.SaldoCuota.ToString("N2")
                                    </td>

                                    <td>
                                        @if (cuota.Estado == "PAGADA")
                                        {
                                            <span class="badge bg-success">
                                                PAGADA
                                            </span>
                                        }
                                        else if (cuota.Estado == "PARCIAL")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                PARCIAL
                                            </span>
                                        }
                                        else if (cuota.Estado == "ATRASADA")
                                        {
                                            <span class="badge bg-danger">
                                                ATRASADA
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                PENDIENTE
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    Este crédito no tiene cuotas registradas.
                </div>
            }

        </div>
    </div>

</div>